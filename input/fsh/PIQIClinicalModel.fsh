* demographics 1..1 BackboneElement "Patient demographics" "Demographics and other administrative information about an individual or animal receiving care or other health-related services."
* demographics ^label = "Demographics"
* demographics ^comment = "A single Demographic element of the Demographics Data Class."
* demographics.birthDate 0..1 string "The patient's date of birth." "The date of birth for the individual."
* demographics.birthDate ^label = "DOB"
* demographics.deceased 0..1 PIQICodeableConcept "Indicates whether the patient is deceased." "Indicates if the individual is deceased or not."
* demographics.deceased ^label = "Deceased"
* demographics.birthSex 0..1 PIQICodeableConcept "The patient's sex assigned at birth *Note: When converting from FHIR, this comes from the gender property." "A code classifying the person's sex assigned at birth."
* demographics.birthSex ^label = "Birth Sex"
* demographics.birthSex from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1021.24 (required)
* demographics.genderIdentity 0..1 PIQICodeableConcept "The patient's gender identity." "An individual's personal sense of being a man, woman, boy, girl, nonbinary, or something else."
* demographics.genderIdentity ^label = "Gender Idty"
* demographics.genderIdentity from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1021.32 (extensible)
* demographics.race 0..1 PIQICodeableConcept "The patient's race." "Concepts classifying the person into a named category of humans sharing common history, traits, geographical origin or nationality.  The race codes used to represent these concepts are based upon the [Race & Ethnicity - CDC (CDCREC)](https://phinvads.cdc.gov/vads/ViewCodeSystem.action?id=2.16.840.1.113883.6.238) code system. Detailed race concepts are grouped by and pre-mapped to the 5 OMB race categories:

   - American Indian or Alaska Native
   - Asian
   - Black or African American
   - Native Hawaiian or Other Pacific Islander
   - White."
* demographics.race ^label = "Race"
* demographics.race from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.4.642.2.575 (required)
* demographics.ethnicity 0..1 PIQICodeableConcept "The patient's ethnicity." "Concepts classifying the person into a named category of humans sharing common history, traits, geographical origin or nationality.  The ethnicity codes used to represent these concepts are based upon the [Race & Ethnicity - CDC (CDCREC)](https://phinvads.cdc.gov/vads/ViewCodeSystem.action?id=2.16.840.1.113883.6.238) code system. Detailed ethnicity concepts are grouped by and pre-mapped to the 2 OMB ethnicity categories:

   - Hispanic or Latino
   - Not Hispanic or Latino."
* demographics.ethnicity ^label = "Ethnicity"
* demographics.ethnicity from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.4.642.40.2.48.3 (required)
* demographics.maritalStatus 0..1 PIQICodeableConcept "The patient's marital status." "This field contains a patient's most recent marital (civil) status."
* demographics.maritalStatus ^label = "Marital Status"
* demographics.maritalStatus from http://hl7.org/fhir/ValueSet/marital-status (extensible)
* demographics.primaryLanguage 0..1 PIQICodeableConcept "The patients primary language" "The language which can be used to communicate with the patient about his or her health. Coded using a language code from BCP-47 (e.g. \"en\" for English, or \"en-US\" for American English)."
* demographics.primaryLanguage ^label = "Language"
* demographics.primaryLanguage from http://terminology.hl7.org/ValueSet/Languages (extensible)
* demographics.deathDate 0..1 string "The date of death of the patient." "The date (and possibly time) when the patient died."
* demographics.deathDate ^label = "Death Date"
* demographics.patientIdentifier 0..1 string "The unique identifier for the patient." "An identifier for this patient."
* demographics.patientIdentifier ^label = "Patient ID"
* demographics.tribalAffiliation 0..1 PIQICodeableConcept "The patient's affiliation with a recognized American Indian or Alaska Native tribe." "A tribe or band with which a person associates whether or not they are an enrolled member."
* demographics.tribalAffiliation ^label = "Tribal Affil"
* demographics.tribalAffiliation from http://terminology.hl7.org/ValueSet/v3-TribalEntityUS (preferred)
* demographics.sexualOrientation 0..1 PIQICodeableConcept "The patient's self-reported sexual orientation." "The patient's sexual orientation: a person's identification of their emotional, romantic, sexual, or affectional attraction to another person."
* demographics.sexualOrientation ^label = "Sexual Orient"
* demographics.sexualOrientation from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1240.11 (extensible)
* demographics.firstName 0..1 string "The patient's first (given) name." "The patient's first (given) name."
* demographics.firstName ^label = "First Name"
* demographics.lastName 0..1 string "The patient's last (family) name." "The part of a name that links to the genealogy. In some cultures (e.g. Eritrea) the family name of a son is the first name of his father."
* demographics.lastName ^label = "Last Name"
* demographics.middleName 0..1 string "The patient's middle name or initial." "The patient's middle name(s) or initial(s), i.e. given names after the first."
* demographics.middleName ^label = "Middle Name"
* demographics.currentAddress 0..1 string "The patient's current mailing or home address." "The patient's current address: an address for the individual."
* demographics.currentAddress ^label = "Address"
* demographics.emailAddress 0..1 string "The patient's email address." "An email address by which the patient may be contacted."
* demographics.emailAddress ^label = "Email"
* demographics.telecom 0..1 string "The patient's telephone or other telecommunication contact information." "A contact detail (e.g. a telephone number or an email address) by which the individual may be contacted."
* demographics.telecom ^label = "Phone"

* allergies 0..* BackboneElement "Patent allergies and substance intolerances" "Risk of harmful or undesirable, physiological response which is unique to an individual and associated with exposure to a substance."
* allergies ^label = "Allergies"
* allergies ^comment = "A single Allergy element of the Allergy Data Class."
* allergies.substance 0..1 PIQICodeableConcept "The specific substance or allergen responsible for the reaction." "Code for an allergy or intolerance statement (either a positive or a negated/excluded statement).  This may be a code for a substance or pharmaceutical product that is considered to be responsible for the adverse reaction risk (e.g., \"Latex\"), an allergy or intolerance condition (e.g., \"Latex allergy\"), or a negated/excluded code for a specific substance or class (e.g., \"No latex allergy\") or a general or categorical negated statement (e.g.,  \"No known allergy\", \"No known drug allergies\")."
* allergies.substance ^label = "Substance"
* allergies.substance from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1267.43 (extensible)
* allergies.category 0..1 PIQICodeableConcept "The category of the allergy (e.g., medication, food, environment)." "Category of the identified substance."
* allergies.category ^label = "Category"
* allergies.category from http://hl7.org/fhir/ValueSet/allergy-intolerance-category (required)
* allergies.reaction 0..1 PIQICodeableConcept "The clinical manifestation (reaction) resulting from exposure to the allergen." "Clinical symptoms and/or signs that are observed or associated with the adverse reaction event."
* allergies.reaction ^label = "Reaction"
* allergies.reaction from http://hl7.org/fhir/ValueSet/clinical-findings (extensible)
* allergies.severity 0..1 PIQICodeableConcept "The clinical assessment of the severity of the reaction." "Clinical assessment of the severity of the reaction event as a whole, potentially considering multiple different manifestations."
* allergies.severity ^label = "Severity"
* allergies.severity from http://hl7.org/fhir/ValueSet/reaction-event-severity (required)
* allergies.effectiveDate 0..1 string "The date when the allergy or substance intolerance was first recorded." "Estimated or actual date,  date-time, or age when allergy or intolerance was identified."
* allergies.effectiveDate ^label = "Eff Date"
* allergies.clinicalStatus 0..1 PIQICodeableConcept "The clinical status of the allergy or intolerance (e.g., active, inactive, resolved)." "The clinical status of the allergy or intolerance."
* allergies.clinicalStatus ^label = "Clin Status"
* allergies.clinicalStatus from http://hl7.org/fhir/ValueSet/allergyintolerance-clinical (required)
* allergies.verificationStatus 0..1 PIQICodeableConcept "The assertion of the certainty that the propensity to a reaction to the identified substance is present (e.g., confirmed, unconfirmed, refuted)." "Assertion about certainty associated with the propensity, or potential risk, of a reaction to the identified substance (including pharmaceutical product)."
* allergies.verificationStatus ^label = "Verify Status"
* allergies.verificationStatus from http://hl7.org/fhir/ValueSet/allergyintolerance-verification (required)

* conditions 0..* BackboneElement "Patient problems, conditions and diagnoses." "A clinical condition, problem, diagnosis, or other event, situation, issue, or clinical concept that has risen to a level of concern."
* conditions ^label = "Conditions"
* conditions ^comment = "A single Condition element of the Conditions Data Class."
* conditions.condition 0..1 PIQICodeableConcept "A clinical condition, problem, or diagnosis." "Identification of the condition, problem or diagnosis."
* conditions.condition ^label = "Condition"
* conditions.condition from http://hl7.org/fhir/us/core/ValueSet/us-core-condition-code (extensible)
* conditions.onsetDate 0..1 string "The date when the condition started." "Estimated or actual date or date-time  the condition began, in the opinion of the clinician."
* conditions.onsetDate ^label = "Onset Date"
* conditions.conditionStatus 0..1 PIQICodeableConcept "The clinical status of the condition." "The clinical status of the condition."
* conditions.conditionStatus ^label = "Cond Status"
* conditions.resolutionDate 0..1 string "The date when the condition resolved." "The date or estimated date that the condition resolved or went into remission. This is called \"abatement\" because of the many overloaded connotations associated with \"remission\" or \"resolution\" - Conditions are never really resolved, but they can abate."
* conditions.resolutionDate ^label = "Res Date"
* conditions.clinicalStatus 0..1 PIQICodeableConcept "The clinical status of the condition (e.g., active, recurrence, relapse, inactive, remission, resolved)." "The clinical status of the condition."
* conditions.clinicalStatus ^label = "Clin Status"
* conditions.clinicalStatus from http://hl7.org/fhir/ValueSet/condition-clinical (required)
* conditions.verificationStatus 0..1 PIQICodeableConcept "The verification status of the condition, indicating the certainty of the diagnosis (e.g., confirmed, unconfirmed, provisional, refuted)." "The verification status to support the clinical status of the condition."
* conditions.verificationStatus ^label = "Verify Status"
* conditions.verificationStatus from http://hl7.org/fhir/ValueSet/condition-ver-status (required)
* conditions.conditionCategory 0..1 PIQICodeableConcept "The category assigned to the condition (e.g., problem-list-item, encounter-diagnosis, health-concern)." "A category assigned to the condition."
* conditions.conditionCategory ^label = "Category"
* conditions.conditionCategory from http://hl7.org/fhir/ValueSet/condition-category (extensible)
* conditions.assertedDate 0..1 string "The date the condition was first asserted or claimed by the patient or a clinician." "The date on which the existence of the Condition was first asserted or acknowledged."
* conditions.assertedDate ^label = "Assrt Date"
* conditions.recordedDate 0..1 string "The date the condition was first recorded in the patient's clinical record." "The recordedDate represents when this particular Condition record was created in the system, which is often a system-generated date."
* conditions.recordedDate ^label = "Rec Date"

* immunizations 0..* BackboneElement "Patient vaccines and immunizations." "Describes the event of a patient being administered a vaccine or a record of an immunization as reported by a patient, a clinician or another party."
* immunizations ^label = "Immunizations"
* immunizations ^comment = "A single Immunization element of the Immunizations Data Class."
* immunizations.administrationDate 0..1 string "The date the immunization was administered." "Date vaccine administered or was to be administered."
* immunizations.administrationDate ^label = "Admin Date"
* immunizations.immunization 0..1 PIQICodeableConcept "The vaccine or immunization administered." "Vaccine that was administered or was to be administered."
* immunizations.immunization ^label = "Vaccine"
* immunizations.immunization from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1010.6 (extensible)
* immunizations.lotNumber 0..1 string "The lot number of the immunization product." "Lot number of the  vaccine product."
* immunizations.lotNumber ^label = "Lot Number"
* immunizations.reaction 0..1 PIQICodeableConcept "The reaction to the immunization." "Categorical data indicating that an adverse event is associated in time to an immunization."
* immunizations.reaction ^label = "Reaction"
* immunizations.expirationDate 0..1 string "The expiration date of the immunization product." "Date vaccine batch expires."
* immunizations.expirationDate ^label = "Expiry Date"
* immunizations.immunizationStatus 0..1 PIQICodeableConcept "The immunization status for the immunization.  May include that the immunization was refused." "Indicates the current status of the immunization event."
* immunizations.immunizationStatus ^label = "Imm Status"
* immunizations.immunizationStatus from http://hl7.org/fhir/ValueSet/immunization-status (required)
* immunizations.immunizationStatusReason 0..1 PIQICodeableConcept "Reason not done" "Indicates the reason the immunization event was not performed."
* immunizations.immunizationStatusReason ^label = "Status Reason"
* immunizations.primarySource 0..1 string "Indicates context the data was recorded in" "Indicates whether the data was captured by the individual/organization which was responsible for the administration of the vaccine, rather than as 'secondary reported' data documented by a third party."
* immunizations.primarySource ^label = "Primary Source"

* labResults 0..* BackboneElement "Patient laboratory results." "Measurements and simple assertions made about a patient, device or other subject."
* labResults ^label = "Lab Results"
* labResults ^comment = "A single Lab Result element of the Lab Results Data Class."
* labResults.order 0..1 PIQICodeableConcept "The order or panel that initiated the test." "The order or panel that initiated the test being performed (e.g. a laboratory panel)."
* labResults.order ^label = "Order"
* labResults.order from http://hl7.org/fhir/us/core/ValueSet/us-core-laboratory-test-codes (extensible)
* labResults.test 0..1 PIQICodeableConcept "The specific laboratory test performed." "The name of the clinical test or procedure performed on a patient.  A LOINC **SHALL** be used if the concept is present in LOINC."
* labResults.test ^label = "Lab Test"
* labResults.test from http://hl7.org/fhir/us/core/ValueSet/us-core-laboratory-test-codes (extensible)
* labResults.resultUnit 0..1 PIQICodeableConcept "The unit of measure for the laboratory result value." "The unit of the result value, where the result is quantitative. Expected to be a UCUM unit."
* labResults.resultUnit ^label = "Result Unit"
* labResults.resultValue 0..1 PIQIObservationValue "The value of the laboratory result." "The laboratory result value. If a coded value, the code SHOULD be selected from SNOMED CT if the concept exists. If a numeric value, the unit SHALL be a UCUM unit."
* labResults.resultValue ^label = "Result Value"
* labResults.interpretation 0..1 PIQICodeableConcept "The interpretation of the laboratory result." "A categorical assessment of an observation value.  For example, high, low, normal."
* labResults.interpretation ^label = "Interp"
* labResults.interpretation from http://hl7.org/fhir/ValueSet/observation-interpretation (extensible)
* labResults.specimenType 0..1 PIQICodeableConcept "The type of specimen used for the test." "The kind of material that forms the specimen."
* labResults.specimenType ^label = "Spec Type"
* labResults.specimenType from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1099.54 (extensible)
* labResults.resultStatus 0..1 PIQICodeableConcept "The status of the laboratory result." "The status of the result value."
* labResults.resultStatus ^label = "Result Status"
* labResults.resultStatus from http://hl7.org/fhir/ValueSet/observation-status (required)
* labResults.performedDateTime 0..1 string "The date and time the test was performed." "The time or time-period the observed value is asserted as being true. For biological subjects - e.g. human patients - this is usually called the \"physiologically relevant time\". This is usually either the time of the procedure or of specimen collection, but very often the source of the date/time is not known, only the date/time itself."
* labResults.performedDateTime ^label = "Perf Date"
* labResults.issuedDateTime 0..1 string "The date and time the lab test result was issued" "The date and time this version of the observation was made available to providers, typically after the results have been reviewed and verified."
* labResults.issuedDateTime ^label = "Issued Date"
* labResults.referenceRange 0..1 PIQIRangeValue "The reference range for the laboratory test result." "Guidance on how to interpret the value by comparison to a normal or recommended range."
* labResults.referenceRange ^label = "Ref Range"
* labResults.performingSite 0..1 PIQICodeableConcept "The site where the laboratory test was performed." "The laboratory (site) responsible for performing the test."
* labResults.performingSite ^label = "Perf Site"
* labResults.specimenIdentifier 0..1 string "The identifier for the specimen used to perform the laboratory test." "Id for specimen."
* labResults.specimenIdentifier ^label = "Specimen ID"
* labResults.specimenSourceSite 0..1 PIQICodeableConcept "The concept used to represent the site for the specimen used to perform the test." "Anatomical location from which the specimen was collected (if subject is a patient). This is the target site.  This element is not used for environmental specimens."
* labResults.specimenSourceSite ^label = "Source Site"
* labResults.specimenSourceSite from http://hl7.org/fhir/ValueSet/body-site (extensible)
* labResults.specimenCondition 0..1 PIQICodeableConcept "The concept representing the condition of the specimen used to perform the laboratory test." "A mode or state of being that describes the nature of the specimen."
* labResults.specimenCondition ^label = "Spec Condition"
* labResults.specimenCondition from http://hl7.org/fhir/us/core/ValueSet/us-core-specimen-condition (extensible)
* labResults.specimenCollectionDateTime 0..1 string "The date and time the specimen for the laboratory test was collected." "Time when specimen was collected from subject - the physiologically relevant time."
* labResults.specimenCollectionDateTime ^label = "Coll Date"
* labResults.orderDate 0..1 string "The date the laboratory order was placed." "The date the test was ordered (requested)."
* labResults.orderDate ^label = "Order Date"
* labResults.labCategory 0..1 PIQICodeableConcept "Classification of type of observation" "A code that classifies the general type of observation being made."
* labResults.labCategory ^label = "Category"
* labResults.labCategory from http://hl7.org/fhir/ValueSet/observation-category (preferred)
* labResults.performerName 0..1 string "The name of the laboratory or organization that performed the test." "The name of the individual responsible for the result."
* labResults.performerName ^label = "Perf Name"
* labResults.performerIdentifier 0..1 string "The unique identifier of the laboratory or organization that performed the test." "An identifier for the individual responsible for the result (e.g. NPI)."
* labResults.performerIdentifier ^label = "Perf ID"

* medications 0..* BackboneElement "Patient medication statements." "A medication the patient is taking, has taken, or is intended to take, as recorded in a medication order (request) or medication statement."
* medications ^label = "Medications"
* medications ^comment = "A single Medication element of the Medications Data Class."
* medications.medication 0..1 PIQICodeableConcept "The medication product" "Identifies the medication (drug), using a code from a known list of medications (e.g. RxNorm) where possible."
* medications.medication ^label = "Medication"
* medications.medication from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1010.4 (extensible)
* medications.doseAmount 0..1 string "The amount of medication per dose." "The amount of medication per dose, expressed in strength or eaches. For a 200mg total dose delivered via 2 100mg tablets, the doseAmount is 200."
* medications.doseAmount ^label = "Dose Amt"
* medications.doseAmount from http://hl7.org/fhir/ValueSet/ucum-common (preferred)
* medications.doseAmountUnit 0..1 PIQICodeableConcept "The unit of measure for the dose amount." "The unit of the dose amount. For a 200mg total dose delivered via 2 100mg tablets, the doseAmountUnit is mg."
* medications.doseAmountUnit ^label = "Dose Amt Unit"
* medications.doseAmountUnit from http://hl7.org/fhir/ValueSet/ucum-common (preferred)
* medications.doseRoute 0..1 PIQICodeableConcept "The route of administration for the medication." "How drug should enter body."
* medications.doseRoute ^label = "Route"
* medications.doseRoute from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1267.22 (extensible)
* medications.doseQuantity 0..1 string "The quantity of medication dispensed." "The number of units (e.g. tablets) that make up a dose. For a 200mg total dose delivered via 2 100mg tablets, the doseQuantity is 2."
* medications.doseQuantity ^label = "Dose Qty"
* medications.doseQuantityUnit 0..1 PIQICodeableConcept "The unit of measure for the dose quantity." "The unit of the dose quantity. For a 200mg total dose delivered via 2 100mg tablets, the doseQuantityUnit is {Tablet}."
* medications.doseQuantityUnit ^label = "Dose Qty Unit"
* medications.instructions 0..1 string "The instructions for taking the medication" "Free text dosage instructions e.g. SIG."
* medications.instructions ^label = "Instructions"
* medications.indication 0..1 PIQICodeableConcept "The indication or reason for the medication." "The reason or the indication for ordering or not ordering the medication."
* medications.indication ^label = "Indication"
* medications.indication from http://hl7.org/fhir/us/core/ValueSet/us-core-condition-code (extensible)
* medications.startDate 0..1 string "The date the patient started the medication." "The date the patient started taking the medication."
* medications.startDate ^label = "Start Date"
* medications.endDate 0..1 string "The date the patient stopped taking the medication." "The date the patient stopped (or will stop) taking the medication."
* medications.endDate ^label = "End Date"
* medications.statementDate 0..1 string "The date of the medication statement." "The date when the medication statement was asserted by the information source."
* medications.statementDate ^label = "Statement Date"
* medications.adherence 0..1 PIQICodeableConcept "The patient's adherence to the medication regimen." "Reported adherence to prescribed medication instructions."
* medications.adherence ^label = "Adherence"
* medications.adherence from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1240.8 (extensible)
* medications.fillStatus 0..1 PIQICodeableConcept "The fill status of the medication." "The status of the dispense (fill) of the medication."
* medications.fillStatus ^label = "Fill Status"
* medications.fillStatus from http://hl7.org/fhir/ValueSet/medicationdispense-status (required)
* medications.requestStatus 0..1 PIQICodeableConcept "The current status of the medication request, such as active, stopped, or completed." "A code specifying the current state of the order.  Generally, this will be active or completed state."
* medications.requestStatus ^label = "Req Status"
* medications.requestStatus from http://hl7.org/fhir/ValueSet/medicationrequest-status (required)
* medications.medicationCategory 0..1 PIQICodeableConcept "Classification of the medication context, such as community or inpatient." "Indicates the type of medication request (for example, where the medication is expected to be consumed or administered (i.e. inpatient or outpatient))."
* medications.medicationCategory ^label = "Category"
* medications.medicationCategory from http://hl7.org/fhir/ValueSet/medicationrequest-category (required)
* medications.medicationIntent 0..1 PIQICodeableConcept "The intended purpose of the medication record, such as order, plan, or proposal." "Whether the request is a proposal, plan, or an original order."
* medications.medicationIntent ^label = "Intent"
* medications.medicationIntent from http://hl7.org/fhir/ValueSet/medicationrequest-intent (required)

* procedures 0..* BackboneElement "Patient medical and surgical procedures." "An action that is or was performed on or for a patient. This can be a physical intervention like an operation, or less invasive like long term services, counseling, or hypnotherapy."
* procedures ^label = "Procedures"
* procedures ^comment = "A single Procedure element of the Procedures Data Class."
* procedures.procedureDateTime 0..1 string "The date and time the procedure was performed." "Estimated or actual date, date-time, period, or age when the procedure was performed.  Allows a period to support complex procedures that span more than one date, and also allows for the length of the procedure to be captured."
* procedures.procedureDateTime ^label = "Proc Date"
* procedures.procedure 0..1 PIQICodeableConcept "The procedure performed on the patient." "The specific procedure that is performed. Use text if the exact nature of the procedure cannot be coded (e.g. \"Laparoscopic Appendectomy\")."
* procedures.procedure ^label = "Procedure"
* procedures.procedure from http://hl7.org/fhir/us/core/ValueSet/us-core-procedure-code (extensible)
* procedures.procedureReason 0..1 PIQICodeableConcept "The reason for the procedure." "The coded reason why the procedure was performed. This may be a coded entity of some type, or may simply be present as text."
* procedures.procedureReason ^label = "Reason"
* procedures.procedureReason from http://hl7.org/fhir/us/core/ValueSet/us-core-condition-code (extensible)
* procedures.procedureStatus 0..1 PIQICodeableConcept "The concept representing the procedure status." "A code specifying the state of the procedure. Generally, this will be the in-progress or completed state."
* procedures.procedureStatus ^label = "Proc Status"
* procedures.procedureStatus from http://hl7.org/fhir/ValueSet/event-status (required)
* procedures.procedurePerformedDate 0..1 string "The date and time the procedure was performed." "Estimated or actual date, date-time, period, or age when the procedure was performed.  Allows a period to support complex procedures that span more than one date, and also allows for the length of the procedure to be captured."
* procedures.procedurePerformedDate ^label = "Perf Date"

* vitalSigns 0..* BackboneElement "Patient vital sign measurements." "Measurements of the patient's vital signs (e.g. blood pressure, heart rate, respiratory rate, temperature, oxygen saturation, body height and weight)."
* vitalSigns ^label = "Vital Signs"
* vitalSigns ^comment = "A single Vital Sign element of the Vital Signs Data Class."
* vitalSigns.vitalSign 0..1 PIQICodeableConcept "A specific vital sign assessment or test." "The vital sign that was measured (e.g. heart rate, body weight). A LOINC code SHOULD be used."
* vitalSigns.vitalSign ^label = "Vital Sign"
* vitalSigns.vitalSign from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.88.12.80.62 (extensible)
* vitalSigns.resultValue 0..1 PIQIObservationValue "The value of the vital sign result." "The vital sign result value. Vital sign values are typically quantities."
* vitalSigns.resultValue ^label = "Result Value"
* vitalSigns.resultUnit 0..1 PIQICodeableConcept "The unit of measure for the vital sign result." "The unit of the vital sign result. Expected to be a UCUM unit."
* vitalSigns.resultUnit ^label = "Result Unit"
* vitalSigns.resultUnit from http://hl7.org/fhir/ValueSet/ucum-vitals-common (extensible)
* vitalSigns.interpretation 0..1 PIQICodeableConcept "The interpretation of the vital sign." "A categorical assessment of an observation value.  For example, high, low, normal."
* vitalSigns.interpretation ^label = "Interpretation"
* vitalSigns.interpretation from http://hl7.org/fhir/ValueSet/observation-interpretation (extensible)
* vitalSigns.resultStatus 0..1 PIQICodeableConcept "The status of the vital sign result." "The status of the result value."
* vitalSigns.resultStatus ^label = "Result Status"
* vitalSigns.resultStatus from http://hl7.org/fhir/ValueSet/observation-status (required)
* vitalSigns.performedDateTime 0..1 string "The date and time the vital sign was measured." "The date and time the vital sign was measured (the physiologically relevant time)."
* vitalSigns.performedDateTime ^label = "Perf Date"
* vitalSigns.performingSite 0..1 PIQICodeableConcept "The site where the vital sign was measured." "The site (organization or location) responsible for the vital sign measurement."
* vitalSigns.performingSite ^label = "Perf Site"
* vitalSigns.referenceRange 0..1 PIQIRangeValue "The reference range for the vital sign." "Guidance on how to interpret the value by comparison to a normal or recommended range."
* vitalSigns.referenceRange ^label = "Ref Range"
* vitalSigns.issuedDateTime 0..1 string "The date and time the vital sign was issued." "The date and time this version of the observation was made available to providers, typically after the results have been reviewed and verified."
* vitalSigns.issuedDateTime ^label = "Issued Date"
* vitalSigns.vitalSignCategory 0..1 PIQICodeableConcept "Classification of the vital sign type." "A code that classifies the general type of observation being made."
* vitalSigns.vitalSignCategory ^label = "Category"
* vitalSigns.vitalSignCategory from http://hl7.org/fhir/ValueSet/observation-category (preferred)
* vitalSigns.dataAbsentReason 0..1 PIQICodeableConcept "The reason a vital sign result value is absent or not available." "Provides a reason why the expected result value is missing."
* vitalSigns.dataAbsentReason ^label = "Abs Reason"
* vitalSigns.dataAbsentReason from http://hl7.org/fhir/ValueSet/data-absent-reason (extensible)

* diagnosticImaging 0..* BackboneElement "Patient diagnostic imaging results." "The findings and interpretation of diagnostic  tests performed on patients, groups of patients, devices, and locations, and/or specimens derived from these. The report includes clinical context such as requesting and provider information, and some mix of atomic results, images, textual and coded interpretations, and formatted representation of diagnostic reports."
* diagnosticImaging ^label = "Diagnostic Imaging"
* diagnosticImaging ^comment = "A single Diagnostic Imaging element of the Diagnostic Imaging Data Class."
* diagnosticImaging.interpretation 0..1 string "The interpretation of the diagnostic images." "Concise and clinically contextualized summary conclusion (interpretation/impression) of the diagnostic report."
* diagnosticImaging.interpretation ^label = "Interp"
* diagnosticImaging.reportDateTime 0..1 string "The date and time the diagnostic imaging was performed." "The time or time-period the observed values are related to. When the subject of the report is a patient, this is usually either the time of the procedure or of specimen collection(s), but very often the source of the date/time is not known, only the date/time itself."
* diagnosticImaging.reportDateTime ^label = "Rpt Date"
* diagnosticImaging.procedure 0..1 PIQICodeableConcept "the concept representing the diagnostic imaging procedure." "The test, panel, report, or note that was ordered."
* diagnosticImaging.procedure ^label = "Procedure"
* diagnosticImaging.procedure from http://hl7.org/fhir/us/core/ValueSet/us-core-diagnosticreport-report-and-note-codes (extensible)
* diagnosticImaging.hasAttachment 0..1 string "An indicator representing whether or not a digital attachment was present in the original diagnostic imaging resource. (Interpreted and populated by the PIQI converter)" "Whether the report includes an attached rendition of the report (e.g. a PDF)."
* diagnosticImaging.hasAttachment ^label = "Has Attch"
* diagnosticImaging.issueDate 0..1 string "The date and time the diagnostic imaging report was issued." "The date and time that this version of the report was made available to providers, typically after the report was reviewed and verified."
* diagnosticImaging.issueDate ^label = "Issue Date"
* diagnosticImaging.reportStatus 0..1 PIQICodeableConcept "The current status of the imaging report, such as final, preliminary, or amended." "The status of the diagnostic report."
* diagnosticImaging.reportStatus ^label = "Status"
* diagnosticImaging.reportStatus from http://hl7.org/fhir/ValueSet/diagnostic-report-status (required)
* diagnosticImaging.reportCategory 0..1 PIQICodeableConcept "Classification of the type of diagnostic imaging report." "A code that classifies the clinical discipline, department or diagnostic service that created the report (e.g. cardiology, biochemistry, hematology, MRI). This is used for searching, sorting and display purposes."
* diagnosticImaging.reportCategory ^label = "Rpt Cat"
* diagnosticImaging.reportCategory from http://hl7.org/fhir/us/core/ValueSet/us-core-diagnosticreport-category (required)
* diagnosticImaging.reportPeriodStart 0..1 string "The start date of the period covered by the imaging report." "The start of the clinically relevant period of the report."
* diagnosticImaging.reportPeriodStart ^label = "Period Start"
* diagnosticImaging.reportPeriodEnd 0..1 string "The end date of the period covered by the imaging report." "The end of the clinically relevant period of the report."
* diagnosticImaging.reportPeriodEnd ^label = "Period End"
* diagnosticImaging.reportResultValue 0..1 PIQIObservationValue "The quantitative or qualitative result value from the imaging report." "The result value. If a coded value, the code SHOULD be selected from SNOMED CT if the concept exists. If a numeric value, the unit SHALL be a UCUM unit."
* diagnosticImaging.reportResultValue ^label = "Result Value"
* diagnosticImaging.reportResultUnit 0..1 PIQICodeableConcept "The unit of measure for any quantitative imaging result value." "The unit of the result value, where the result is quantitative. Expected to be a UCUM unit."
* diagnosticImaging.reportResultUnit ^label = "Result Unit"
* diagnosticImaging.dataAbsentReason 0..1 PIQICodeableConcept "The reason an imaging result value is absent or not available." "Provides a reason why the expected result value is missing."
* diagnosticImaging.dataAbsentReason ^label = "Abs Reason"
* diagnosticImaging.dataAbsentReason from http://hl7.org/fhir/ValueSet/data-absent-reason (extensible)
* diagnosticImaging.performerName 0..1 string "The name of the clinician or organization that performed the imaging study." "The name of the individual responsible for the report."
* diagnosticImaging.performerName ^label = "Perf Name"
* diagnosticImaging.performerIdentifier 0..1 string "The unique identifier of the clinician or organization that performed the imaging study." "An identifier for the individual responsible for the report (e.g. NPI)."
* diagnosticImaging.performerIdentifier ^label = "Perf ID"

* medicalDevices 0..* BackboneElement "Patient implanted and prosthetic medical devices." "A type of a manufactured item that is used in the provision of healthcare without being substantially changed through that activity. The device may be a medical or non-medical device."
* medicalDevices ^label = "Medical Devices"
* medicalDevices ^comment = "A single Medical Device element of the Medical Devices Data Class."
* medicalDevices.deviceID 0..1 string "The unique identifier for the medical device." "The device identifier (DI) is a mandatory, fixed portion of a UDI that identifies the labeler and the specific version or model of a device."
* medicalDevices.deviceID ^label = "Dev ID"
* medicalDevices.deviceType 0..1 PIQICodeableConcept "The type of medical device." "The kind or type of device."
* medicalDevices.deviceType ^label = "Type"
* medicalDevices.deviceType from http://hl7.org/fhir/ValueSet/device-kind (extensible)
* medicalDevices.implantationDate 0..1 string "The date the device was implanted." "The date the device was implanted."
* medicalDevices.implantationDate ^label = "Implant Date"
* medicalDevices.deviceStatus 0..1 PIQICodeableConcept "The status of the medical device." "Status of the Device availability."
* medicalDevices.deviceStatus ^label = "Status"
* medicalDevices.deviceStatus from http://hl7.org/fhir/ValueSet/device-status (required)
* medicalDevices.serialNumber 0..1 string "The serial number assigned by the manufacturer to identify the specific medical device." "The serial number assigned by the organization when the device was manufactured."
* medicalDevices.serialNumber ^label = "Serial No"
* medicalDevices.lotNumber 0..1 string "The lot or batch number assigned by the manufacturer to the medical device." "Lot number assigned by the manufacturer."
* medicalDevices.lotNumber ^label = "Lot Number"
* medicalDevices.expirationDate 0..1 string "The expiration date of the medical device as indicated on the device label." "The date and time beyond which this device is no longer valid or should not be used (if applicable)."
* medicalDevices.expirationDate ^label = "Expiry Date"
* medicalDevices.manufactureDate 0..1 string "The date the medical device was manufactured." "The date and time when the device was manufactured."
* medicalDevices.manufactureDate ^label = "Mfr Date"
* medicalDevices.carrierHRF 0..1 string "The human-readable form of the carrier or distributor identifier for the medical device." "The full UDI carrier as the human readable form (HRF) representation of the barcode string as printed on the packaging of the device."
* medicalDevices.carrierHRF ^label = "Carrier HRF"
* medicalDevices.distinctIdentifier 0..1 string "A distinct identification code required by regulation for a human cell, tissue, or cellular and tissue-based product." "The distinct identification string as required by regulation for a human cell, tissue, or cellular and tissue-based product."
* medicalDevices.distinctIdentifier ^label = "Distinct ID"

* healthAssessments 0..* BackboneElement "Patient health assessment observations." "Measurements and simple assertions made about a patient, device or other subject."
* healthAssessments ^label = "Health Assessments"
* healthAssessments ^comment = "A single Health Assessment element of the Health Assessments Data Class."
* healthAssessments.assessment 0..1 PIQICodeableConcept "A specific health assessment observation." "Describes what was observed. Sometimes this is called the observation \"name\"."
* healthAssessments.assessment ^label = "Assessment"
* healthAssessments.assessment from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1267.13 (preferred)
* healthAssessments.assessmentStatus 0..1 PIQICodeableConcept "The current status of the health assessment, such as final, preliminary, or amended." "The status of the result value."
* healthAssessments.assessmentStatus ^label = "Status"
* healthAssessments.assessmentStatus from http://hl7.org/fhir/ValueSet/observation-status (required)
* healthAssessments.resultValue 0..1 PIQIObservationValue "The value of the health assessment result ." "The information determined as a result of making the observation, if the information has a simple value."
* healthAssessments.resultValue ^label = "Result Value"
* healthAssessments.resultUnit 0..1 PIQICodeableConcept "The unit of measure for the health assessment result." "The unit of the assessment result, where the result is quantitative. Expected to be a UCUM unit."
* healthAssessments.resultUnit ^label = "Result Unit"
* healthAssessments.effectiveDate 0..1 string "The date and time the health assessment was performed." "The time or time-period the observed value is asserted as being true. For biological subjects - e.g., human patients - this is usually called the \"physiologically relevant time\"."
* healthAssessments.effectiveDate ^label = "Eff Date"
* healthAssessments.issueDateTime 0..1 string "The date and time the health assessment result was issued." "The date and time this version of the observation was made available to providers, typically after the results have been reviewed and verified."
* healthAssessments.issueDateTime ^label = "Issue Date"
* healthAssessments.category 0..1 PIQICodeableConcept "The category of the health assessment observation (e.g., functional status, disability status, SDOH)." "Categories that a provider may use in their workflow to classify that this Observation is related to a USCDI Health Status/Assessments Data Class."
* healthAssessments.category ^label = "Category"
* healthAssessments.category from http://hl7.org/fhir/us/core/ValueSet/us-core-screening-assessment-observation-maximum-category (required)
* healthAssessments.questionnaireURL 0..1 string "The URL or identifier of the questionnaire or survey instrument used for the assessment." "The URL of the survey, form, or questionnaire that was answered to produce the assessment."
* healthAssessments.questionnaireURL ^label = "Questionnaire"
* healthAssessments.performerName 0..1 string "The name of the clinician or organization that performed the health assessment." "The name of the individual responsible for the assessment."
* healthAssessments.performerName ^label = "Perf Name"
* healthAssessments.performerIdentifier 0..1 string "The unique identifier of the clinician or organization that performed the health assessment." "An identifier for the individual responsible for the assessment (e.g. NPI)."
* healthAssessments.performerIdentifier ^label = "Perf ID"

* clinicalDocuments 0..* BackboneElement "Patient clinical documents," "A reference to a document of any kind for any purpose. Provides metadata about the document so that the document can be discovered and managed. The scope of a document is any seralized object with a mime-type, so includes formal patient centric documents (CDA), cliical notes, scanned paper, and non-patient specific documents like policy text."
* clinicalDocuments ^label = "Clinical Documents"
* clinicalDocuments ^comment = "A single Document element of the Documents Data Class."
* clinicalDocuments.documentType 0..1 PIQICodeableConcept "The concept representing the type of clinical document." "Specifies the particular kind of document referenced  (e.g. History and Physical, Discharge Summary, Progress Note). This usually equates to the purpose of making the document referenced."
* clinicalDocuments.documentType ^label = "Doc Type"
* clinicalDocuments.documentType from http://hl7.org/fhir/us/core/ValueSet/us-core-documentreference-type (required)
* clinicalDocuments.documentTitle 0..1 string "The document title the the clinical document." "The title of the document."
* clinicalDocuments.documentTitle ^label = "Doc Title"
* clinicalDocuments.effectiveDate 0..1 string "The effective date and time of the document." "When the document reference was created."
* clinicalDocuments.effectiveDate ^label = "Eff Date"
* clinicalDocuments.documentStatus 0..1 PIQICodeableConcept "The concept representing the status of the clinical document." "The status of this document reference."
* clinicalDocuments.documentStatus ^label = "Doc Status"
* clinicalDocuments.documentStatus from http://hl7.org/fhir/ValueSet/document-reference-status (required)
* clinicalDocuments.hasAttachment 0..1 string "The indicator representing whether or not the original clinical document resource included a digital attachment.  (Interpreted and populated by the PIQI converter)" "Whether the document content is present as an attachment."
* clinicalDocuments.hasAttachment ^label = "Has Attch"
* clinicalDocuments.documentIdentifier 0..1 string "The unique identifier assigned to the clinical document." "Other identifiers associated with the document, including version independent identifiers."
* clinicalDocuments.documentIdentifier ^label = "Doc ID"
* clinicalDocuments.documentCategory 0..1 PIQICodeableConcept "The category of the clinical document (e.g., clinical note, discharge summary, progress note)." "A categorization for the type of document referenced - helps for indexing and searching. This may be implied by or derived from the code specified in the DocumentReference.type."
* clinicalDocuments.documentCategory ^label = "Doc Category"
* clinicalDocuments.documentCategory from http://hl7.org/fhir/us/core/ValueSet/us-core-documentreference-category (required)
* clinicalDocuments.documentAuthorName 0..1 string "The name of the author who created or is responsible for the clinical document." "The name of the author of the document."
* clinicalDocuments.documentAuthorName ^label = "Author Name"
* clinicalDocuments.documentAuthorIdentifier 0..1 string "The unique identifier of the author who created or is responsible for the clinical document." "An identifier for the author of the document (e.g. NPI)."
* clinicalDocuments.documentAuthorIdentifier ^label = "Author ID"
* clinicalDocuments.documentPeriodStart 0..1 string "The start date of the period that the clinical document content covers or pertains to." "The start of the time period over which the service that is described by the document was provided."
* clinicalDocuments.documentPeriodStart ^label = "Period Start"
* clinicalDocuments.documentPeriodEnd 0..1 string "The end date of the period that the clinical document content covers or pertains to." "The end of the time period over which the service that is described by the document was provided."
* clinicalDocuments.documentPeriodEnd ^label = "Period End"
* clinicalDocuments.documentFormat 0..1 PIQICodeableConcept "The technical format or encoding of the clinical document (e.g., PDF, CDA, FHIR)." "An identifier of the document encoding, structure, and template that the document conforms to beyond the base format indicated in the mimeType."
* clinicalDocuments.documentFormat ^label = "Doc Format"
* clinicalDocuments.documentFormat from http://terminology.hl7.org/ValueSet/v3-HL7FormatCodes (extensible)

* encounters 0..* BackboneElement "Patient healthcare encounters." "An interaction between a patient and healthcare provider(s) for the purpose of providing healthcare service(s) or assessing the health status of a patient."
* encounters ^label = "Encounters"
* encounters ^comment = "A single Encounter element of the Encounters Data Class."
* encounters.encounterIdentifier 0..1 PIQICodeableConcept "The unique identifier for the encounter." "Identifier(s) by which this encounter is known."
* encounters.encounterIdentifier ^label = "Enc ID"
* encounters.encounterIdentifierNamespace 0..1 string "The namespace or system that assigned the encounter identifier, used to ensure uniqueness across systems." "Establishes the namespace for the value - that is, a URL that describes a set values that are unique."
* encounters.encounterIdentifierNamespace ^label = "ID Namespace"
* encounters.encounterDiagnosis 0..1 PIQICodeableConcept "The concept representing the encounter diagnosis or chief complaint." "A diagnosis relevant to the encounter."
* encounters.encounterDiagnosis ^label = "Diagnosis"
* encounters.encounterDiagnosis from http://hl7.org/fhir/us/core/ValueSet/us-core-condition-code (extensible)
* encounters.encounterDisposition 0..1 string "The encounter representing the encounter disposition." "Category or kind of location after discharge."
* encounters.encounterDisposition ^label = "Disposition"
* encounters.encounterDisposition from http://terminology.hl7.org/ValueSet/v3-USEncounterDischargeDisposition (preferred)
* encounters.encounterDateTime 0..1 string "The date and time of the start of the encounter" "The date (and time) of the encounter."
* encounters.encounterDateTime ^label = "Enc Date"
* encounters.encounterStartDate 0..1 string "The date and time the encounter began." "The start date (and time) of the encounter."
* encounters.encounterStartDate ^label = "Start Date"
* encounters.encounterEndDateTime 0..1 string "The date and time the encounter concluded." "The end date (and time) of the encounter."
* encounters.encounterEndDateTime ^label = "End Date"
* encounters.encounterLocation 0..1 string "The encounter location." "The location where the encounter takes place."
* encounters.encounterLocation ^label = "Location"
* encounters.encounterType 0..1 PIQICodeableConcept "The concept representing the category of health care service. (e.g., office visit, telephone assessment, home visit)" "Specific type of encounter (e.g. e-mail consultation, surgical day-care, skilled nursing, rehabilitation)."
* encounters.encounterType ^label = "Enc Type"
* encounters.encounterType from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1267.23 (extensible)
* encounters.encounterReason 0..1 PIQICodeableConcept "The concept representing the reason for the encounter." "Reason the encounter takes place, expressed as a code. For admissions, this can be used for a coded admission diagnosis."
* encounters.encounterReason ^label = "Reason"
* encounters.encounterReason from http://hl7.org/fhir/ValueSet/encounter-reason (preferred)
* encounters.encounterStatus 0..1 PIQICodeableConcept "The concept representing the status of the encounter." "The current state of the encounter (e.g. planned, in-progress, finished, cancelled)."
* encounters.encounterStatus ^label = "Enc Status"
* encounters.encounterStatus from http://hl7.org/fhir/ValueSet/encounter-status (required)
* encounters.encounterClass 0..1 PIQICodeableConcept "The classification of the encounter setting (e.g., inpatient, outpatient, emergency, home health)." "Concepts representing classification of patient encounter such as ambulatory (outpatient), inpatient, emergency, home health or others due to local variations."
* encounters.encounterClass ^label = "Class"
* encounters.encounterClass from http://terminology.hl7.org/ValueSet/v3-ActEncounterCode (extensible)

* goals 0..* BackboneElement "Patient healthcare related goals." "Describes the intended objective(s) for a patient, group or organization care, for example, weight loss, restoring an activity of daily living, obtaining herd immunity via immunization, meeting a process improvement objective, etc."
* goals ^label = "Goals"
* goals ^comment = "A single Encounter element of the Encounters Data Class."
* goals.goalCategory 0..1 PIQICodeableConcept "The concept representing the category of the goal." "Indicates a category the goal falls within."
* goals.goalCategory ^label = "Category"
* goals.goalPriority 0..1 string "The priority of the goal." "Identifies the mutually agreed level of importance associated with reaching/sustaining the goal."
* goals.goalPriority ^label = "Priority"
* goals.goalPriority from http://hl7.org/fhir/ValueSet/goal-priority (preferred)
* goals.goal 0..1 PIQICodeableConcept "The concept representing the patient goal.  (SDOH goals, Treatable Prevention Preferences, Care Experience Preferences, etc.)" "Human-readable and/or coded description of a specific desired objective of care, such as \"control blood pressure\" or \"negotiate an obstacle course\" or \"dance with child at wedding\"."
* goals.goal ^label = "Goal"
* goals.goal from http://hl7.org/fhir/us/core/ValueSet/us-core-goal-description (preferred)
* goals.goalStatus 0..1 string "The concept representing the status of the goal." "The state of the goal throughout its lifecycle."
* goals.goalStatus ^label = "Status"
* goals.goalStatus from http://hl7.org/fhir/ValueSet/goal-status (required)
* goals.startDate 0..1 string "The date and time the patient goal was initiated." "The date or event after which the goal should begin being pursued."
* goals.startDate ^label = "Start Date"
* goals.effectiveDate 0..1 string "The date and time of the documentation of the goal." "Identifies when the current status.  I.e. When initially created, when achieved, when cancelled, etc."
* goals.effectiveDate ^label = "Effective Date"
* goals.dueDate 0..1 string "The target date by which the patient goal is intended to be achieved." "Indicates either the date or the duration after start by which the goal should be met."
* goals.dueDate ^label = "Due Date"

* carePlans 0..* BackboneElement "Collection of patient care plan records documenting goals and planned interventions." "Describes the intention of how one or more practitioners intend to deliver care for a particular patient, group or community for a period of time, possibly limited to care for a specific condition or set of conditions."
* carePlans ^label = "Care Plans"
* carePlans ^comment = "A single patient care plan record."
* carePlans.planNarrative 0..1 string "A human-readable summary of the care plan, including its goals, activities, and context." "The narrative (human readable) content of the care plan, including the assessment and plan of treatment."
* carePlans.planNarrative ^label = "Narrative"
* carePlans.planNarrativeStatus 0..1 PIQICodeableConcept "The status of the narrative text associated with the care plan (e.g., generated, additional)." "The status of the narrative - whether it's entirely generated (from just the defined data or the extensions too), or whether a human authored it and it may contain additional data."
* carePlans.planNarrativeStatus ^label = "Narr Status"
* carePlans.planNarrativeStatus from http://hl7.org/fhir/us/core/ValueSet/us-core-narrative-status (required)
* carePlans.planStatus 0..1 PIQICodeableConcept "The status of the care plan (e.g., draft, active, on-hold, revoked, completed)." "Indicates whether the plan is currently being acted upon, represents future intentions or is now a historical record."
* carePlans.planStatus ^label = "Plan Status"
* carePlans.planStatus from http://hl7.org/fhir/ValueSet/request-status (required)
* carePlans.planIntent 0..1 PIQICodeableConcept "The intent of the care plan, indicating the level of authority and authorization (e.g., proposal, plan, order)." "Indicates the level of authority/intentionality associated with the care plan and where the care plan fits into the workflow chain."
* carePlans.planIntent ^label = "Plan Intent"
* carePlans.planIntent from http://hl7.org/fhir/ValueSet/care-plan-intent (required)
* carePlans.planCategory 0..1 PIQICodeableConcept "The category or type of care plan (e.g., assess-plan, longitudinal)." "Type of plan."
* carePlans.planCategory ^label = "Plan Category"
* carePlans.planCategory from http://hl7.org/fhir/ValueSet/care-plan-category (preferred)
* carePlans.effectiveDate 0..1 string "The date and time the care plan became or becomes effective." "Indicates when the plan did (or is intended to) come into effect and end."
* carePlans.effectiveDate ^label = "Eff Date"

* practitioners 0..* BackboneElement "A member of the care team" "A person who is directly or indirectly involved in the provisioning of healthcare."
* practitioners ^label = "Practitioners"
* practitioners ^comment = "A single care team practitioner record associated with the patient."
* practitioners.practitionerName 0..1 string "The care team provider full name." "The name(s) associated with the practitioner."
* practitioners.practitionerName ^label = "Name"
* practitioners.practitionerIdentifier 0..1 string "This is the care team provider identifier.  This would typically be the NPI." "An identifier that applies to this person in this role."
* practitioners.practitionerIdentifier ^label = "Practitioner ID"
* practitioners.practitionerRole 0..1 PIQICodeableConcept "The clinical or administrative role of the care team practitioner." "Roles which this practitioner is authorized to perform for the organization."
* practitioners.practitionerRole ^label = "Role"
* practitioners.practitionerRole from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1099.30 (extensible)
* practitioners.practitionerStatus 0..1 PIQICodeableConcept "The current status of the practitioner within the care team." "Whether this practitioner's record is in active use."
* practitioners.practitionerStatus ^label = "Status"
* practitioners.practitionerAddress 0..1 string "The practice or mailing address of the care team practitioner." "Address(es) of the practitioner"
* practitioners.practitionerAddress ^label = "Address"
* practitioners.practitionerTelecom 0..1 string "The telephone or other telecom contact information for the care team practitioner." "A contact detail for the practitioner, e.g. a telephone number or an email address."
* practitioners.practitionerTelecom ^label = "Contact"

* clinicalTests 0..* BackboneElement "A collection representing clinical test orders and results performed on a patient, including laboratory and diagnostic imaging tests." "Measurements and simple assertions made about a patient, device or other subject."
* clinicalTests ^label = "Clinical Tests"
* clinicalTests ^comment = "A single Clinical Test element of the Clinical Tests Data Class."
* clinicalTests.testStatus 0..1 PIQICodeableConcept "The status of the clinical test (e.g., registered, preliminary, final, amended, cancelled)." "The status of the result value."
* clinicalTests.testStatus ^label = "Status"
* clinicalTests.testStatus from http://hl7.org/fhir/ValueSet/observation-status (required)
* clinicalTests.testCategory 0..1 PIQICodeableConcept "The category of the clinical test (e.g., laboratory, imaging, survey)." "A code that classifies the general type of observation being made."
* clinicalTests.testCategory ^label = "Category"
* clinicalTests.testCategory from http://hl7.org/fhir/us/core/ValueSet/us-core-clinical-result-observation-category (required)
* clinicalTests.test 0..1 PIQICodeableConcept "The concept representing the specific clinical test or observation that was performed." "The name of the clinical test or procedure performed on a patient.  A LOINC **SHALL** be used if the concept is present in LOINC."
* clinicalTests.test ^label = "Test"
* clinicalTests.test from http://hl7.org/fhir/ValueSet/observation-codes (extensible)
* clinicalTests.effectiveDateTime 0..1 string "The date and time the clinical test was performed or the specimen was collected." "The time or time-period the observed value is asserted as being true. For biological subjects - e.g. human patients - this is usually called the \"physiologically relevant time\". This is usually either the time of the procedure or of specimen collection, but very often the source of the date/time is not known, only the date/time itself."
* clinicalTests.effectiveDateTime ^label = "Eff Date"
* clinicalTests.testPeriodStart 0..1 string "The start date of the period over which the clinical test was performed or observed." "The start of the period over which the test was performed."
* clinicalTests.testPeriodStart ^label = "Period Start"
* clinicalTests.testPeriodEnd 0..1 string "The end date of the period over which the clinical test was performed or observed." "The end of the period over which the test was performed."
* clinicalTests.testPeriodEnd ^label = "Period End"
* clinicalTests.resultValue 0..1 PIQIObservationValue "The result value of the clinical test, which may be a quantity, coded value, or string." "The result value. If a coded value, the code SHOULD be selected from SNOMED CT if the concept exists. If a numeric value, the unit SHALL be a UCUM unit."
* clinicalTests.resultValue ^label = "Result Value"
* clinicalTests.resultUnit 0..1 PIQICodeableConcept "The unit of measure associated with the clinical test result value." "The unit of the test result, where the result is quantitative. Expected to be a UCUM unit."
* clinicalTests.resultUnit ^label = "Result Unit"
* clinicalTests.testDataAbsentReason 0..1 PIQICodeableConcept "The reason why a result value is absent or not available for the clinical test." "Provides a reason why the expected result value is missing."
* clinicalTests.testDataAbsentReason ^label = "Abs Reaspn"
* clinicalTests.testDataAbsentReason from http://hl7.org/fhir/ValueSet/data-absent-reason (extensible)
* clinicalTests.issueDate 0..1 string "The date the clinical test order was issued or requested." "The date and time this version of the observation was made available to providers, typically after the results have been reviewed and verified."
* clinicalTests.issueDate ^label = "Issue Date"
* clinicalTests.hasAttachment 0..1 string "Indicator representing whether the clinical test result includes a digital attachment such as an image or report." "Whether the test result includes an attached rendition of the report (e.g. a PDF)."
* clinicalTests.hasAttachment ^label = "Has Attch"
* clinicalTests.performerName 0..1 string "The name of the person or organization that performed the clinical test." "The name of the individual responsible for the test."
* clinicalTests.performerName ^label = "Performer Name"
* clinicalTests.performerIdentifier 0..1 string "The unique identifier of the person or organization that performed the clinical test." "An identifier for the individual responsible for the test (e.g. NPI)."
* clinicalTests.performerIdentifier ^label = "Performer ID"

* coverage 0..* BackboneElement "A collection representing a patient's insurance coverage details as reported by the payer." "Financial instrument which may be used to reimburse or pay for health care products and services. Includes both insurance and self-payment."
* coverage ^label = "Coverage"
* coverage ^comment = "A single Coverage element of the Coverage Data Class."
* coverage.coverageStatus 0..1 PIQICodeableConcept "The status of the coverage record (e.g., active, cancelled, draft, entered-in-error)." "The status of the coverage (e.g. active, cancelled)."
* coverage.coverageStatus ^label = "Status"
* coverage.coverageStatus from http://hl7.org/fhir/ValueSet/fm-status (required)
* coverage.coverageType 0..1 PIQICodeableConcept "The type of insurance coverage (e.g., medical, dental, vision, pharmacy)." "The type of coverage: social program, medical plan, accident coverage (workers compensation, auto), group health or payment by an individual or organization."
* coverage.coverageType ^label = "Coverage Type"
* coverage.coverageType from http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.114222.4.11.3591 (extensible)
* coverage.coveragePeriodStart 0..1 string "The date on which the coverage period begins or the policy became effective." "The date the coverage starts."
* coverage.coveragePeriodStart ^label = "Period Start"
* coverage.coveragePeriodEnd 0..1 string "The date on which the coverage period ends or the policy was terminated." "The date the coverage ends."
* coverage.coveragePeriodEnd ^label = "Period End"
* coverage.relationship 0..1 PIQICodeableConcept "The relationship of the covered member to the primary subscriber (e.g., self, spouse, child, other)." "The relationship of beneficiary (patient) to the subscriber."
* coverage.relationship ^label = "Relationship"
* coverage.relationship from http://hl7.org/fhir/ValueSet/subscriber-relationship (extensible)
* coverage.memberIdentifier 0..1 string "The identifier assigned to the covered member by the payer." "The identifier assigned by the payer to the member (beneficiary) of the coverage."
* coverage.memberIdentifier ^label = "Mem ID"
* coverage.memberIdentifierType 0..1 PIQICodeableConcept "The type of identifier used to uniquely identify the covered member (e.g., member ID, national identifier)." "A coded type for the identifier that can be used to determine which identifier to use for a specific purpose."
* coverage.memberIdentifierType ^label = "Mem ID Type"
* coverage.memberIdentifierType from http://hl7.org/fhir/ValueSet/identifier-type (extensible)
* coverage.subscriberIdentifier 0..1 string "The identifier assigned by the payer to the primary subscriber of the insurance policy." "The insurer assigned ID for the Subscriber."
* coverage.subscriberIdentifier ^label = "Sub ID"
* coverage.payorIdentifier 0..1 string "The unique identifier assigned to the payer or insurer responsible for the coverage." "An identifier for the issuer of the policy (the payer)."
* coverage.payorIdentifier ^label = "Payor ID"
* coverage.planName 0..1 string "The name of the health plan benefit offering associated with the coverage." "The name of the insurance plan."
* coverage.planName ^label = "Plan Name"
* coverage.planIdentifier 0..1 string "The identifier assigned to the specific health plan benefit offering." "The identifier of the insurance plan, as issued by the insurer."
* coverage.planIdentifier ^label = "Plan ID"
* coverage.groupName 0..1 string "The name of the employer group or plan sponsor associated with the coverage." "The name of the employer group (or other group) that holds the coverage."
* coverage.groupName ^label = "Group Name"
* coverage.groupIdentifier 0..1 string "The identifier assigned to the employer group or plan sponsor associated with the coverage." "The identifier of the group, as issued by the insurer."
* coverage.groupIdentifier ^label = "Group ID"

* provenance 0..* BackboneElement "Collection of data provenance records documenting the source and authorship of clinical data." "Provenance of a resource is a record that describes entities and processes involved in producing and delivering or otherwise influencing that resource. Provenance provides a critical foundation for assessing authenticity, enabling trust, and allowing reproducibility. Provenance assertions are a form of contextual metadata and can themselves become important records with their own provenance. Provenance statement indicates clinical significance in terms of confidence in authenticity, reliability, and trustworthiness, integrity, and stage in lifecycle (e.g. Document Completion - has the artifact been legally authenticated), all of which may impact security, privacy, and trust policies."
* provenance ^label = "Provenance"
* provenance ^comment = "A single data provenance record documenting source and authorship of a clinical data record."
* provenance.recordedDateTime 0..1 string "The date and time the provenance record was captured." "The instant of time at which the activity was recorded."
* provenance.recordedDateTime ^label = "Recorded Date"
* provenance.agentType 0..1 PIQICodeableConcept "The type of agent responsible for the clinical data record, such as practitioner or system." "The participation the agent had with respect to the activity."
* provenance.agentType ^label = "Agent Type"
* provenance.agentType from http://terminology.hl7.org/ValueSet/provenance-agent-type (extensible)
* provenance.agentName 0..1 string "The name of the agent responsible for the clinical data record." "The name of the individual or system that participated in the activity."
* provenance.agentName ^label = "Agent Name"
* provenance.agentIdentifier 0..1 string "The unique identifier of the agent responsible for the clinical data record." "An identifier for the individual or system that participated in the activity."
* provenance.agentIdentifier ^label = "Agent ID"
* provenance.agentOrganizationName 0..1 string "The name of the organization associated with the provenance agent." "The name of the organization the agent was acting for."
* provenance.agentOrganizationName ^label = "Org Name"
* provenance.agentOrganizationIdentifier 0..1 string "The unique identifier of the organization associated with the provenance agent." "An identifier for the organization the agent was acting for."
* provenance.agentOrganizationIdentifier ^label = "Org ID"
* provenance.authorType 0..1 PIQICodeableConcept "The type of author that created or contributed to the clinical record." "The type of participation of the author."
* provenance.authorType ^label = "Author Type"
* provenance.authorType from http://terminology.hl7.org/ValueSet/provenance-agent-type (extensible)
* provenance.transmitterType 0..1 PIQICodeableConcept "The type of system or entity that transmitted the clinical data record." "The type of participation of the transmitter."
* provenance.transmitterType ^label = "Transmitter"
* provenance.transmitterType from http://terminology.hl7.org/ValueSet/provenance-agent-type (extensible)

