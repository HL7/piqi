Logical: PIQIModel
Parent: Base
Id: PIQIModel
Title: "PIQI Model Elements - Logical Model"
Description: "Abstract model of PIQI Model, which is a flat, patient-centric structured information model that defines the shape of the data payload evaluated by PIQI Rubrics. "
Characteristics: #can-be-target
* name 1..1 string "PIQI Model Human Readable Name"
* mnemonic 1..1 id "The computable reference to this PIQI Model"
* version 1..1 decimal "The version of this PIQI Model"
* modelTypeName 0..1 string "TBD"
* baseModel 0..1 boolean "TBD"
* rootEntityName 1..1 string "TBD"
* rootEntityMnemonic 1..1 id "TBD"
* dataClasses 1..* BackboneElement "TBD"
* dataClasses.name 0..1 string "TBD"
* dataClasses.mnemonic 1..1 id "TBD"
* dataClasses.fieldName 0..1 string "TBD"
* dataClasses.shortName 0..1 string "TBD"
* dataClasses.description 0..1 string "TBD"
* dataClasses.isInherited 0..1 boolean "TBD"
* dataClasses.sequence 1..1 integer "TBD"
* dataClasses.cardinality 1..1 BackboneElement "TBD"
* dataClasses.cardinality.name 0..1 string "TBD"
* dataClasses.cardinality.mnemonic 1..1 id "TBD"
* dataClasses.attributes 1..* BackboneElement "TBD"
* dataClasses.attributes.name 0..1 string "TBD"
* dataClasses.attributes.mnemonic 1..1 id "TBD"
* dataClasses.attributes.shortName 0..1 string "TBD"
* dataClasses.attributes.fieldName 0..1 string "TBD"
* dataClasses.attributes.description 0..1 string "TBD"
* dataClasses.attributes.sequence 1..1 integer "TBD"
* dataClasses.attributes.autoGenerated 0..1 boolean "TBD"
* dataClasses.attributes.isInherited 0..1 boolean "TBD"
* dataClasses.attributes.attributeType 1..1 BackboneElement "TBD"
* dataClasses.attributes.attributeType.name 0..1 string "TBD"
* dataClasses.attributes.attributeType.mnemonic 1..1 code "Must be selected from: ATR| CC | CLS | ELM | OBSVAL | RV"
* dataClasses.roles 0..* BackboneElement "TBD"
* dataClasses.roles.roleTypeName 1..1 string "TBD"
* dataClasses.roles.roleTypeMnemonic 1..1 id "TBD"
* dataClasses.roles.attributeName 1..1 string "TBD"
* dataClasses.roles.attributeMnemonic 1..1 id "TBD"

