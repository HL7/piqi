* claimServiceLine.quantityDispensed 0..1 string "Quantity dispensed for the drug." "The number of repetitions of a service or product."
* claimServiceLine.quantityDispensed ^label = "Quantity Dispensed"
* claimServiceLine.quantityQualifierCode 0..1 PIQICodeableConcept "The unit of measurement for the drug. (gram, ml, etc.)." "The unit of measurement for the drug. (gram, ml, etc.)."
* claimServiceLine.quantityQualifierCode ^label = "Quantity Qualifier Code"
* claimServiceLine.benefitPaymentStatus 0..1 PIQICodeableConcept "Indicates the in network or out of network payment status of the claim." "Indicates the in network or out of network payment status of the claim."
* claimServiceLine.benefitPaymentStatus ^label = "Benefit Payment Status"
* claimServiceLine.linePaymentDenialCode 0..1 PIQICodeableConcept "Reason codes used to interpret the Non-Covered Amount that are provided to the Provider" "Reason codes used to interpret the Non-Covered Amount that are provided to the Provider"
* claimServiceLine.linePaymentDenialCode ^label = "Line Payment Denial Code"
* claimServiceLine.paymentMemberExplanation 0..1 string "Payment explanation to a member on an EOB" "Payment explanation to a member on an EOB"
* claimServiceLine.paymentMemberExplanation ^label = "Payment member explanation"
* claimServiceLine.lineNoncoveredAmount 0..1 string "Medical: The portion of the cost of this service that was deemed not eligible by the insurer because the service or member was not covered by the subscriber contract.

Pharmacy: Non-Covered Amount represents the NCPDP financial response field Amount Exceeding Periodic Benefit Maximum." "Medical: The portion of the cost of this service that was deemed not eligible by the insurer because the service or member was not covered by the subscriber contract.

Pharmacy: Non-Covered Amount represents the NCPDP financial response field Amount Exceeding Periodic Benefit Maximum."
* claimServiceLine.lineNoncoveredAmount ^label = "Line Noncovered Amount"
* claimServiceLine.lineMemberReimbursement 0..1 string "The amount paid to the member." "The amount paid to the member."
* claimServiceLine.lineMemberReimbursement ^label = "Line Member Reimbursement"
* claimServiceLine.linePaymentAmount 0..1 string "The amount sent to the payee from the health plan. This amount is to exclude any member cost sharing.  It should include the total of member and provider payments." "The amount sent to the payee from the health plan. This amount is to exclude any member cost sharing.  It should include the total of member and provider payments."
* claimServiceLine.linePaymentAmount ^label = "Line Payment Amount"
* claimServiceLine.lineDiscountAmount 0..1 string "The amount of the discount." "The amount of the discount."
* claimServiceLine.lineDiscountAmount ^label = "Line Discount Amount"
* claimServiceLine.lineAmountPaidByPatient 0..1 string "Medical: The amount paid by the member at the point of service.

Pharmacy: Amount that is calculated by the processor and returned to the pharmacy as the total amount to be paid by the patient to the pharmacy; the patient’s total cost share, including copayments, amounts applied to deductible, over maximum amounts, penalties, etc" "Medical: The amount paid by the member at the point of service.

Pharmacy: Amount that is calculated by the processor and returned to the pharmacy as the total amount to be paid by the patient to the pharmacy; the patient’s total cost share, including copayments, amounts applied to deductible, over maximum amounts, penalties, etc"
* claimServiceLine.lineAmountPaidByPatient ^label = "Line Amount Paid by Patient"
* claimServiceLine.drugCost 0..1 string "Price paid for the drug excluding mfr discounts.  It is the sum of the following components:ingredient cost, dispensing fee, sales tax, and vaccine administration fee." "Price paid for the drug excluding mfr discounts.  It is the sum of the following components:ingredient cost, dispensing fee, sales tax, and vaccine administration fee."
* claimServiceLine.drugCost ^label = "Drug Cost"
* claimServiceLine.lineAllowedAmount 0..1 string "The contracted reimbursable amount for covered medical services or supplies or amount reflecting local methodology for noncontracted providers. Allowed  amount should not include any COB adjustment. That is, the Allowed amount on a claim should be the same when the Plan is primary or secondary." "The contracted reimbursable amount for covered medical services or supplies or amount reflecting local methodology for noncontracted providers. Allowed  amount should not include any COB adjustment. That is, the Allowed amount on a claim should be the same when the Plan is primary or secondary."
* claimServiceLine.lineAllowedAmount ^label = "Line Allowed Amount"
* claimServiceLine.lineAmountPaidToProvider 0..1 string "The amount paid to the provider." "The amount paid to the provider."
* claimServiceLine.lineAmountPaidToProvider ^label = "Line Amount Paid to Provider"
* claimServiceLine.linePatientDeductible 0..1 string "The contracted reimbursable amount for covered medical services or supplies or amount reflecting local methodology for noncontracted providers." "The contracted reimbursable amount for covered medical services or supplies or amount reflecting local methodology for noncontracted providers."
* claimServiceLine.linePatientDeductible ^label = "Line Patient Deductible"
* claimServiceLine.lineOtherPayerPaidAmount 0..1 string "The reduction in the payment amount to reflect the current carrier as a secondary, tertiary, etc, payer.  May be multiple occurrences if the current carrier is a tertiary, etc. carrier." "The reduction in the payment amount to reflect the current carrier as a secondary, tertiary, etc, payer.  May be multiple occurrences if the current carrier is a tertiary, etc. carrier."
* claimServiceLine.lineOtherPayerPaidAmount ^label = "Line Other Payer Paid Amount"
* claimServiceLine.lineCoinsuranceAmount 0..1 string "Medical: The amount the insured individual pays, as a set percentage of the cost of covered medical services, as an out-of-pocket payment to the provider. Example: Insured pays 20% and the insurer pays 80%.
Pharmacy: Amount to be collected from a patient that is included in the Patient Pay Amount that is due to a per prescription copay or coinsurance." "Medical: The amount the insured individual pays, as a set percentage of the cost of covered medical services, as an out-of-pocket payment to the provider. Example: Insured pays 20% and the insurer pays 80%.
Pharmacy: Amount to be collected from a patient that is included in the Patient Pay Amount that is due to a per prescription copay or coinsurance."
* claimServiceLine.lineCoinsuranceAmount ^label = "Line Coinsurance Amount"
* claimServiceLine.lineSubmittedAmount 0..1 string "Amount submitted by the provider for reimbursement of health care services. This amount includes non-covered services." "Amount submitted by the provider for reimbursement of health care services. This amount includes non-covered services."
* claimServiceLine.lineSubmittedAmount ^label = "Line Submitted Amount"
* claimServiceLine.lineMemberLiabilityAmount 0..1 string "The amount of the member's liability." "The amount of the member's liability."
* claimServiceLine.lineMemberLiabilityAmount ^label = "Line Member Liability"
* claimServiceLine.lineCopayAmount 0..1 string "Medical: Amount an insured individual pays directly to a provider at the time the services or supplies are rendered. Usually, a copay will be a fixed amount per service, such as $15.00 per office visit.
Pharmacy: Amount to be collected from a patient that is included in the Patient Pay Amount that is due to a per prescription copay or coinsurance." "Medical: Amount an insured individual pays directly to a provider at the time the services or supplies are rendered. Usually, a copay will be a fixed amount per service, such as $15.00 per office visit.
Pharmacy: Amount to be collected from a patient that is included in the Patient Pay Amount that is due to a per prescription copay or coinsurance."
* claimServiceLine.lineCopayAmount ^label = "Line Copay Amount"
* claimServiceLine.lineProcedureCode 0..1 PIQICodeableConcept "Medical procedure a patient received from a health care provider. Current coding methods include: CPT-4 and HCFA Common Procedure Coding System Level II - (HCPCSII).  Health Insurance Prospective Payment System (HIPPS) rate codes represent specific sets of patient characteristics (or case-mix groups) health insurers use to make payment determinations under several prospective payment systems" "When the value is a group code then this item collects a set of related claim details, otherwise this contains the product, service, drug or other billing code for the item."
* claimServiceLine.lineProcedureCode ^label = "line procedure code"
* claimServiceLine.lineProcedureCodeModifier 0..1 PIQICodeableConcept "Modifier(s) for the procedure represented on this line. Identifies special circumstances related to the performance of the service." "Item typification or modifiers codes to convey additional context for the product or service."
* claimServiceLine.lineProcedureCodeModifier ^label = "line procedure code modifier"

* claimDiagnosis 1..* BackboneElement "A collection representing the diagnoses associated with a claim, including admitting, principal, and secondary diagnoses." "Information about diagnoses relevant to the claim items."
* claimDiagnosis ^label = "Claim Diagnosis"
* claimDiagnosis ^comment = "A single Diagnosis element of the Claim Diagnosis Data Class."
* claimDiagnosis.diagnosisCode 0..1 PIQICodeableConcept "21- ICD-10-CM code describing the condition chiefly responsible for a patient's admission to a facility. It may be different from the principal diagnosis, which is the diagnosis assigned after evaluation. Decimals will be included.

22 - The member's principal condition treated during this service. This may or may not be different from the admitting diagnosis. Decimals will be included.

23 - Additional diagnosis identified for this member. Decimals will be included." "The nature of illness or problem in a coded form or as a reference to an external defined Condition."
* claimDiagnosis.diagnosisCode ^label = "Diagnosis Code"
* claimDiagnosis.eCodeIndicator 0..1 string "This is any valid ICD-10 Diagnosis code in the range V00.* through Y99.*" "This is any valid ICD-10 Diagnosis code in the range V00.* through Y99.*"
* claimDiagnosis.eCodeIndicator ^label = "Is E code"
* claimDiagnosis.presentOnAdmissionIndicator 0..1 string "Used to capture whether a diagnosis was present at time of a patient's admission. This is used to group diagnoses into the proper DRG for all claims involving inpatient admissions to general acute care facilities." "Indication of whether the diagnosis was present on admission to a facility."
* claimDiagnosis.presentOnAdmissionIndicator ^label = "Present on Admission"
* claimDiagnosis.diagnosisType 0..1 PIQICodeableConcept "Indicates if the diagnosis is admitting, principal, other, an external cause of injury or secondary" "When the condition was observed or the relative ranking."
* claimDiagnosis.diagnosisType ^label = "Diagnosis Type"

* claimProcedure 1..* BackboneElement "Claim Procedure" "Procedures performed on the patient relevant to the billing items with the claim."
* claimProcedure ^label = "Claim Procedure"
* claimProcedure.procedureClaimLine 0..1 string "The reference back to a particular claim line where 0 or null is the header" "The reference back to a particular claim line where 0 or null is the header"
* claimProcedure.procedureClaimLine ^label = "Procedure Line"
* claimProcedure.procedureCode 0..1 PIQICodeableConcept "24 –Principal medical procedure a patient received during inpatient stay. Coding methods for this field is International Classification of Diseases Surgical Procedures (ICD-10).
26 – Additional surgical procedure a patient received during inpatient stay. Coding methods for this field is International Classification of Diseases Surgical Procedures (ICD-10).
40 - Medical procedure  Current coding methods include: CPT-4 and HCFA Common Procedure Coding System Level II - (HCPCSII)." "The code or reference to a Procedure resource which identifies the clinical intervention performed."
* claimProcedure.procedureCode ^label = "Procedure Code"
* claimProcedure.procedureDate 0..1 string "24- Principal medical procedure a patient received during inpatient stay. Coding methods for this field is International Classification of Diseases Surgical Procedures (ICD-10).

26 - Additional surgical procedure a patient received during inpatient stay. Coding methods for this field is International Classification of Diseases Surgical Procedures (ICD-10)." "Date and optionally time the procedure was performed."
* claimProcedure.procedureDate ^label = "Procedure Date"
* claimProcedure.procedureType 0..1 PIQICodeableConcept "Indicates whether procedure is 'principal' or 'other'" "The category of the procedure (e.g. principal or other)."
* claimProcedure.procedureType ^label = "Procedure Type"
* claimProcedure.modifierCode1 0..1 PIQICodeableConcept "Modifier(s) for the procedure represented on this line. Identifies special circumstances related to the performance of the service." "Modifier(s) for the procedure represented on this line. Identifies special circumstances related to the performance of the service."
* claimProcedure.modifierCode1 ^label = "Modifier Code -1"
* claimProcedure.modifierCode2 0..1 PIQICodeableConcept "Modifier(s) for the procedure represented on this line. Identifies special circumstances related to the performance of the service." "Modifier(s) for the procedure represented on this line. Identifies special circumstances related to the performance of the service."
* claimProcedure.modifierCode2 ^label = "Modifier Code -2"
* claimProcedure.modifierCode3 0..1 PIQICodeableConcept "Modifier(s) for the procedure represented on this line. Identifies special circumstances related to the performance of the service." "Modifier(s) for the procedure represented on this line. Identifies special circumstances related to the performance of the service."
* claimProcedure.modifierCode3 ^label = "Modifier Code -3"
* claimProcedure.modifierCode4 0..1 PIQICodeableConcept "Modifier(s) for the procedure represented on this line. Identifies special circumstances related to the performance of the service." "Modifier(s) for the procedure represented on this line. Identifies special circumstances related to the performance of the service."
* claimProcedure.modifierCode4 ^label = "Modifier Code -4"

* pharmacyClaim 1..* BackboneElement "Pharmacy Claim" "This resource provides: the claim details; adjudication details from the processing of a Claim; and optionally account balance information, for informing the subscriber of the benefits provided."
* pharmacyClaim ^label = "Pharmacy Claim"
* pharmacyClaim.daysSupply 0..1 string "Number of days supply of medication dispensed by the pharmacy." "Number of days supply of medication dispensed by the pharmacy."
* pharmacyClaim.daysSupply ^label = "Days Supply"
* pharmacyClaim.rxServiceReferenceNumber 0..1 string "Identifier assigned by a payer for a claim received from a provider or subscriber. It is not the same identifier as that assigned by a provider. This identifier assigned by the payer becomes the payer's EOB identifier." "Identifier assigned by a payer for a claim received from a provider or subscriber. It is not the same identifier as that assigned by a provider. This identifier assigned by the payer becomes the payer's EOB identifier."
* pharmacyClaim.rxServiceReferenceNumber ^label = "RX Service Ref No"
* pharmacyClaim.dawCode 0..1 string "Prescriber's instruction regarding substitution of generic equivalents or order to dispense the specific prescribed medication." "Prescriber's instruction regarding substitution of generic equivalents or order to dispense the specific prescribed medication."
* pharmacyClaim.dawCode ^label = "DAW Code"
* pharmacyClaim.refillNumber 0..1 string "The number fill of the current dispensed supply (0, 1, 2, etc.)." "The number fill of the current dispensed supply (0, 1, 2, etc.)."
* pharmacyClaim.refillNumber ^label = "Refill Number"
* pharmacyClaim.prescriptionOriginCode 0..1 string "Whether the prescription was transmitted as an electronic prescription, by phone, by fax, or as a written paper copy" "Whether the prescription was transmitted as an electronic prescription, by phone, by fax, or as a written paper copy"
* pharmacyClaim.prescriptionOriginCode ^label = "Presc Origin Code"
* pharmacyClaim.planReportedBrandGenericCode 0..1 PIQICodeableConcept "Whether the plan adjudicated the claim as a brand or generic drug." "Whether the plan adjudicated the claim as a brand or generic drug."
* pharmacyClaim.planReportedBrandGenericCode ^label = "Plan Brand-Generic Code"
* pharmacyClaim.totalAmount 0..1 string "Total amount for each category (i.e., submitted, eligible, etc.)" "Total amount for each category (i.e., submitted, eligible, etc.)"
* pharmacyClaim.totalAmount ^label = "Total Amount"
* pharmacyClaim.claimIdentifierAmount 0..1 string "Indicates that the claim identifier is that assigned by a payer for a claim received from a provider or subscriber." "Indicates that the claim identifier is that assigned by a payer for a claim received from a provider or subscriber."
* pharmacyClaim.claimIdentifierAmount ^label = "Claim Identifier Amount"
* pharmacyClaim.adjudicationAmountType 0..1 string "Describes the various amount fields used when payers receive and adjudicate a claim" "Describes the various amount fields used when payers receive and adjudicate a claim"
* pharmacyClaim.adjudicationAmountType ^label = "Adj Amount Type"

* dentalClaim 1..* BackboneElement "A collection representing a dental claim submitted to a payer for dental services rendered to a patient." "This resource provides: the claim details; adjudication details from the processing of a Claim; and optionally account balance information, for informing the subscriber of the benefits provided."
* dentalClaim ^label = "Dental Claim"
* dentalClaim ^comment = "A single Dental Claim element of the Dental Claim Data Class."
* dentalClaim.procedureCode 0..1 PIQICodeableConcept "Dental procedure that a patient received from a health care provider. Current coding methods for reporting dental services are based on Current Dental Terminology, commonly known as CDT published by the American Dental Association (ADA)." "When the value is a group code then this item collects a set of related claim details, otherwise this contains the product, service, drug or other billing code for the item."
* dentalClaim.procedureCode ^label = "Procedure Code"
* dentalClaim.procedureModifierCode 0..1 PIQICodeableConcept "Modifier(s) for the dental procedure represented on this line. Identifies special circumstances related to the performance of the service." "Item typification or modifiers codes to convey additional context for the product or service."
* dentalClaim.procedureModifierCode ^label = "Procedure Modifier Code"
* dentalClaim.toothNumberFirstOccurrence 0..1 PIQICodeableConcept "Indicates the tooth notation i.e. the unique number or letter designated to the teeth, of the first occurrence. The values are based on the American Dental Association (ADA)'s Universal Numbering System/National Tooth Designation system for tooth numbers. (01 - 32 for permanent teeth; A – T for deciduous teeth). (01 - 32 for permanent teeth; A – T for deciduous teeth)." "The tooth number (first occurrence) the service applies to."
* dentalClaim.toothNumberFirstOccurrence ^label = "Tooth No - First Occ"
* dentalClaim.toothSurface 0..1 PIQICodeableConcept "Indicates the specific areas of the teeth. This is based on the ADA's Universal standard mandated under HIPAA 837D." "A region or surface of the bodySite, e.g. limb region or tooth surface(s)."
* dentalClaim.toothSurface ^label = "Tooth Surface"
* dentalClaim.missingToothNumberFirstOccurrence 0..1 PIQICodeableConcept "Indicates the first occurrence of the missing tooth number. The values are based on the American Dental Association (ADA)'s Universal Numbering System/National Tooth Designation system for tooth numbers. (01 - 32 for permanent teeth; A – T for deciduous teeth). (01 - 32 for permanent teeth; A – T for deciduous teeth)." "Indicates the first occurrence of the missing tooth number. The values are based on the American Dental Association (ADA)'s Universal Numbering System/National Tooth Designation system for tooth numbers. (01 - 32 for permanent teeth; A – T for deciduous teeth). (01 - 32 for permanent teeth; A – T for deciduous teeth)."
* dentalClaim.missingToothNumberFirstOccurrence ^label = "Missing Tooth Number - First Occurrence"
* dentalClaim.orthodonticsTreatmentIndicator 0..1 string "Indicates if the treatment is for orthodontics" "Indicates if the treatment is for orthodontics"
* dentalClaim.orthodonticsTreatmentIndicator ^label = "Orthodontics Treatment Indicator"
* dentalClaim.orthodonticsApplianceApplicationDate 0..1 string "Date that the orthodontic appliances were placed." "Date that the orthodontic appliances were placed."
* dentalClaim.orthodonticsApplianceApplicationDate ^label = "Orthodontics Appliance Application Date"
* dentalClaim.totalNumberOfMonthsForOrthodontia 0..1 string "Number of months the orthodontia will remain in place." "Number of months the orthodontia will remain in place."
* dentalClaim.totalNumberOfMonthsForOrthodontia ^label = "Total Number of Months for Orthodontia"
* dentalClaim.prosthesisReplacementIndicator 0..1 string "Indicate whether the services billed are for an oral prosthesis such as bridges, dentures, etc." "Indicate whether the services billed are for an oral prosthesis such as bridges, dentures, etc."
* dentalClaim.prosthesisReplacementIndicator ^label = "Prosthesis Replacement Indicator"
* dentalClaim.dateOfPriorProsthesisPlacement 0..1 string "Identify the date when the prior prosthesis was placed." "Identify the date when the prior prosthesis was placed."
* dentalClaim.dateOfPriorProsthesisPlacement ^label = "Date of Prior Prosthesis Placement"
* dentalClaim.toothNumberAfterFirstOccurrence 0..1 PIQICodeableConcept "Indicates the tooth notation i.e. the unique number or letter designated to the teeth, for those after the first occurrence. The values are based on the American Dental Association (ADA)'s Universal Numbering System/National Tooth Designation system for tooth numbers. (01 - 32 for permanent teeth; A – T for deciduous teeth). (01 - 32 for permanent teeth; A – T for deciduous teeth)." "Additional tooth numbers (after the first occurrence) the service applies to."
* dentalClaim.toothNumberAfterFirstOccurrence ^label = "Tooth Number - After First Occurrence"
* dentalClaim.missingToothNumberAfterFirstOccurrence 0..1 PIQICodeableConcept "Indicates the missing tooth number after the first occurrence. The values are based on the American Dental Association (ADA)'s Universal Numbering System/National Tooth Designation system for tooth numbers. (01 - 32 for permanent teeth; A – T for deciduous teeth). (01 - 32 for permanent teeth; A – T for deciduous teeth)." "Indicates the missing tooth number after the first occurrence. The values are based on the American Dental Association (ADA)'s Universal Numbering System/National Tooth Designation system for tooth numbers. (01 - 32 for permanent teeth; A – T for deciduous teeth). (01 - 32 for permanent teeth; A – T for deciduous teeth)."
* dentalClaim.missingToothNumberAfterFirstOccurrence ^label = "Missing Tooth Number - After First Occurrence"

* provider 1..* BackboneElement "Provider" "A person who is directly or indirectly involved in the provisioning of healthcare."
* provider ^label = "Provider"
* provider.providerNpi 0..1 string "The National Provider Identifier assigned to the Provider." "The National Provider Identifier (NPI) of the provider."
* provider.providerNpi ^label = "Provider NPI"
* provider.providerContractingStatus 0..1 PIQICodeableConcept "Indicates that the Billing Provider has a contract with the Payer as of the effective date of service or admission." "Indicates that the Billing Provider has a contract with the Payer as of the effective date of service or admission."
* provider.providerContractingStatus ^label = "Provider Contracting Status"
* provider.siteOfServiceNetworkStatus 0..1 PIQICodeableConcept "Indicates the network status of the site of service." "Indicates the network status of the site of service."
* provider.siteOfServiceNetworkStatus ^label = "Site of Service Network Status"
* provider.careTeamRole 0..1 PIQICodeableConcept "The functional role of a provider on a claim." "The lead, assisting or supervising practitioner and their discipline if a multidisciplinary team."
* provider.careTeamRole ^label = "Care Team Role"
* provider.providerName 0..1 string "The name of the Attending Physician for the admission" "The name(s) associated with the practitioner."
* provider.providerName ^label = "Provider Name"
* provider.providerAddress 0..1 string "The address of the facility where the service occurred." "Address(es) of the practitioner"
* provider.providerAddress ^label = "Provider Address"
* provider.providerPayerSpecificIdentifier 0..1 PIQICodeableConcept "Identifies the type of identifiers for practitioners" "An identifier for the provider assigned by the payer."
* provider.providerPayerSpecificIdentifier ^label = "Provider Payer Specific Identifier"
* provider.providerType 0..1 PIQICodeableConcept "Type of provider:  Billing, Attending , Referring , Performing , Prescribing , Service Facility , PCP , Supervising , Operating" "Roles which this practitioner is authorized to perform for the organization."
* provider.providerType ^label = "Provider Type"
