* coverage.payerIdentifier ^label = "Payer Identifier"
* coverage.otherPayerName 0..1 string "Identifies another payer who applied benefits for the service on another claim" "Identifies another payer who applied benefits for the service on another claim"
* coverage.otherPayerName ^label = "Other Payer Name"
* coverage.relationshipToSubscriber 0..1 PIQICodeableConcept "Relationship of the member to the person insured (subscriber)." "The relationship of beneficiary (patient) to the subscriber."
