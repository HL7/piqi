* medicalClaim 1..* BackboneElement "Medical Claim" "This resource provides: the claim details; adjudication details from the processing of a Claim; and optionally account balance information, for informing the subscriber of the benefits provided."
* medicalClaim ^label = "Medical Claim"
* medicalClaim.claimDrgVersion 0..1 string "32 - Version of the DRG codes assigned for inpatient facility claims.
33- Claim diagnosis related group (DRG) code value
113 - Name of the DRG grouper assigned; i.e., MS-DRG, AP-DRG or APR-DRG" "32 - Version of the DRG codes assigned for inpatient facility claims.
33- Claim diagnosis related group (DRG) code value
113 - Name of the DRG grouper assigned; i.e., MS-DRG, AP-DRG or APR-DRG"
* medicalClaim.claimDrgVersion ^label = "Claim DRG Version"
* medicalClaim.claimDrgCode 0..1 PIQICodeableConcept "Claim DRG Code" "Claim DRG Code"
* medicalClaim.claimDrgCode ^label = "DRG code"
* medicalClaim.claimStartDate 0..1 string "90 - Date on which services began.  UB04 (Form Locator 45).
118 - Date on which services began. Located on CMS 1500 (Form Locator 24A)" "The start of the period for which charges are being submitted."
* medicalClaim.claimStartDate ^label = "Claim start date"
* medicalClaim.statementThruDate 0..1 string "On Institutional claims, the last day on the billing statement covering services rendered to the beneficiary (i.e. 'Statement Covers Thru Date’)  On Professional and Non-Clinician claims, the latest of any of the line-item level dates." "The end of the period covered by the claim statement."
* medicalClaim.statementThruDate ^label = "Statement Thru Date"
* medicalClaim.procedureCodeType 0..1 PIQICodeableConcept "Indicates if the inpatient institutional procedure (ICD-PCS) is the principal procedure or another procedure" "Indicates if the inpatient institutional procedure (ICD-PCS) is the principal procedure or another procedure"
* medicalClaim.procedureCodeType ^label = "Procedure Code Type"
* medicalClaim.adjudicationDate 0..1 string "Date the claim was adjudicated" "The date the claim was adjudicated."
* medicalClaim.adjudicationDate ^label = "Adjudication Date"
* medicalClaim.dischargedate 0..1 string "Date the beneficiary was discharged from the facility, or died. Matches the Statement Thru Date. When there is a discharge date, the Patient Discharge Status Code indicates the final disposition of the patient after discharge." "Date the beneficiary was discharged from the facility, or died. Matches the Statement Thru Date. When there is a discharge date, the Patient Discharge Status Code indicates the final disposition of the patient after discharge."
* medicalClaim.dischargedate ^label = "Discharge Date"
* medicalClaim.primaryPayerIdentifier 0..1 PIQICodeableConcept "Identifies the primary payer.  For use only on secondary claims." "An identifier for the primary payer of the claim."
* medicalClaim.primaryPayerIdentifier ^label = "Primary Payer Identifier"
* medicalClaim.claimSubType 0..1 PIQICodeableConcept "High-level categorization of the claim." "A finer grained suite of claim type codes which may convey additional information such as Inpatient vs Outpatient and/or a specialty service."
* medicalClaim.claimSubType ^label = "Claim Sub Type"
* medicalClaim.patientDischargeStatusCode 0..1 PIQICodeableConcept "Patient’s status as of the discharge date for a facility stay. Information located on UB04 (Form Locator 17)." "Patient’s status as of the discharge date for a facility stay. Information located on UB04 (Form Locator 17)."
* medicalClaim.patientDischargeStatusCode ^label = "Patient Discharge Status Code"
* medicalClaim.claimPayerIdentifier 0..1 string "The identifier assigned to the Operating Surgeon." "An identifier for the payer that adjudicated the claim."
* medicalClaim.claimPayerIdentifier ^label = "Claim Payer Identifier"
* medicalClaim.medicalRecordNumber 0..1 string "Provider submitted information that can be included on the claim." "Provider submitted information that can be included on the claim."
* medicalClaim.medicalRecordNumber ^label = "Medical Record Number"
* medicalClaim.claimIdentifierType 0..1 string "Indicates that the claim identifier is that assigned by a payer for a claim received from a provider or subscriber." "Indicates that the claim identifier is that assigned by a payer for a claim received from a provider or subscriber."
* medicalClaim.claimIdentifierType ^label = "Claim Identifier Type"
* medicalClaim.processingStatusCode 0..1 PIQICodeableConcept "Claim processing status code" "The outcome of the claim, predetermination, or preauthorization processing."
* medicalClaim.processingStatusCode ^label = "Processing Status Code"
* medicalClaim.billFacilityTypeCode 0..1 PIQICodeableConcept "UB04 (Form Locator 4) type of bill code provides specific information for payer purposes. The first digit of the three-digit number denotes the type of facility." "UB04 (Form Locator 4) type of bill code provides specific information for payer purposes. The first digit of the three-digit number denotes the type of facility."
* medicalClaim.billFacilityTypeCode ^label = "Bill Facility Type Code"
* medicalClaim.claimAdjustedfromIdentifier 0..1 string "If the current claim represents a claim that has been adjusted and was given a prior claim number, this field represents the prior claim number" "The identifier of the claim that this claim adjusts (replaces)."
* medicalClaim.claimAdjustedfromIdentifier ^label = "Claim Adjusted from Identifier"
* medicalClaim.claimAdjustedtoIdentifier 0..1 string "If the current claim has been adjusted; i.e., replaced by or merged to another claim number, this data element represents that new number." "The identifier of the claim that adjusts (replaces) this claim."
* medicalClaim.claimAdjustedtoIdentifier ^label = "Claim Adjusted to Identifier"
* medicalClaim.claimAdjustedRelationship 0..1 PIQICodeableConcept "The nature of the claim adjustment" "A code to convey how the claims are related."
* medicalClaim.claimAdjustedRelationship ^label = "claim adjusted relationship"
* medicalClaim.claimReceivedDate 0..1 string "The date the claim was received by the payer." "The date the claim was received by the payer."
* medicalClaim.claimReceivedDate ^label = "Claim Received Date"
* medicalClaim.claimPaymentStatusCode 0..1 PIQICodeableConcept "Indicates whether the claim was paid or denied." "Indicates whether the claim was paid or denied."
* medicalClaim.claimPaymentStatusCode ^label = "Payment Status Code"
* medicalClaim.claimPaidDate 0..1 string "The date the claim was paid." "Estimated date the payment will be issued or the actual issue date of payment."
* medicalClaim.claimPaidDate ^label = "Claim Paid Date"
* medicalClaim.claimDiscountAmount 0..1 string "The amount of the discount." "The amount of the discount."
* medicalClaim.claimDiscountAmount ^label = "Claim Discount Amount"
* medicalClaim.serviceClassificationTypeCode 0..1 PIQICodeableConcept "UB04 (Form Locator 4) type of bill code provides specific information for payer purposes. The second digit classifies the type of care (service classification) being billed." "UB04 (Form Locator 4) type of bill code provides specific information for payer purposes. The second digit classifies the type of care (service classification) being billed."
* medicalClaim.serviceClassificationTypeCode ^label = "Service Classification Type Code"
* medicalClaim.patientAccountNumber 0..1 string "Provider submitted information that can be included on the claim." "Provider submitted information that can be included on the claim."
* medicalClaim.patientAccountNumber ^label = "Patient Account Number"
* medicalClaim.claimPayeeTypeCode 0..1 PIQICodeableConcept "Identifies the type of recipient of the adjudication amount; i.e., provider, subscriber, beneficiary or another recipient" "Type of Party to be reimbursed: Subscriber, provider, other."
* medicalClaim.claimPayeeTypeCode ^label = "Claim Payee Type Code"
* medicalClaim.inpatientSourceAdmissionCode 0..1 PIQICodeableConcept "Identifies the place where the patient was identified as needing admission to a facility. This is a two position code mapped from the standard values for the UB-04 Source of Admission code (FL-15)." "Identifies the place where the patient was identified as needing admission to a facility. This is a two position code mapped from the standard values for the UB-04 Source of Admission code (FL-15)."
* medicalClaim.inpatientSourceAdmissionCode ^label = "Inpatient Source admin Code"
* medicalClaim.admissionDate 0..1 string "The date corresponding with admission of the beneficiary to a facility and the onset of services. May precede the Statement From Date if this claim is for a beneficiary who has been continuously under care." "The date corresponding with admission of the beneficiary to a facility and the onset of services. May precede the Statement From Date if this claim is for a beneficiary who has been continuously under care."
* medicalClaim.admissionDate ^label = "Admission Date"
* medicalClaim.paymentDenialCode 0..1 PIQICodeableConcept "Reason codes used to interpret the Non-Covered Amount that are provided to the Provider" "Reason codes used to interpret the Non-Covered Amount that are provided to the Provider"
* medicalClaim.paymentDenialCode ^label = "Payment Denial Code"
* medicalClaim.claimServiceEndDate 0..1 string "119	Claim Service End Date	Date on which services ended. Located on CMS 1500 (Form Locator 24A)" "The end of the period for which charges are being submitted."
* medicalClaim.claimServiceEndDate ^label = "Claim  End Date"
* medicalClaim.claimTypeCode 0..1 PIQICodeableConcept "Specifies the type of claim. (e.g., inpatient institutional, outpatient institutional, physician, etc.)." "The category of claim, e.g. oral, pharmacy, vision, institutional, professional."
* medicalClaim.claimTypeCode ^label = "Claim Type Code"
* medicalClaim.payerClaimUniqueIdentifier 0..1 string "35	Payer Claim Unique Identifier	Identifier assigned by a payer for a claim received from a provider or subscriber. It is not the same identifier as that assigned by a provider." "A unique identifier assigned to this explanation of benefit."
* medicalClaim.payerClaimUniqueIdentifier ^label = "Claim Unique Identifier"
* medicalClaim.adjudicationAmountType 0..1 PIQICodeableConcept "Describes the various amount fields used when payers receive and adjudicate a claim" "A code to indicate the information type of this adjudication record. Information types may include: the value submitted, maximum values or percentages allowed or payable under the plan, amounts that the patient is responsible for in aggregate or pertaining to this item, amounts paid by other coverages, and the benefit payable for this item."
* medicalClaim.adjudicationAmountType ^label = "Adjudication Amount Type"
* medicalClaim.inpatientAdmissionTypeCode 0..1 PIQICodeableConcept "Priority of the admission. Information located on (UB04 Form Locator 14). For example, an admission type of elective indicates that the patient's condition permitted time for medical services to be scheduled." "Priority of the admission. Information located on (UB04 Form Locator 14). For example, an admission type of elective indicates that the patient's condition permitted time for medical services to be scheduled."
* medicalClaim.inpatientAdmissionTypeCode ^label = "Inpatient Admin Type Code"
* medicalClaim.frequencyCode 0..1 PIQICodeableConcept "UB04 (Form Locator 4) type of bill code provides specific information for payer purposes. The third digit identifies the frequency of the bill for a specific course of treatment or inpatient confinement." "UB04 (Form Locator 4) type of bill code provides specific information for payer purposes. The third digit identifies the frequency of the bill for a specific course of treatment or inpatient confinement."
* medicalClaim.frequencyCode ^label = "Frequency Code"
* medicalClaim.claimPayee 0..1 string "Recipient reference." "Reference to the individual or organization to whom any payment will be made."
* medicalClaim.claimPayee ^label = "Claim Payee"
* medicalClaim.totalAmount 0..1 string "Total amount for each category (i.e., submitted, eligible, etc.)" "Monetary total amount associated with the category."
* medicalClaim.totalAmount ^label = "Total Amount"
* medicalClaim.statementFromDate 0..1 string "On Institutional claims, the first day on the billing statement covering services rendered to the beneficiary (i.e. 'Statement Covers From Date’).  On Professional and Non-Clinician claims, Earliest of any of the line-item level dates. It is almost always the same as Claim Service End Date except for DME claims - where some services are billed in advance." "The start of the period covered by the claim statement."
* medicalClaim.statementFromDate ^label = "Statement From Date"
* medicalClaim.claimTotalSubmittedAmount 0..1 string "Amount submitted by the provider for reimbursement of health care services. This amount includes non-covered services." "Amount submitted by the provider for reimbursement of health care services. This amount includes non-covered services."
* medicalClaim.claimTotalSubmittedAmount ^label = "total submitted amount"
* medicalClaim.claimTotalAllowedAmount 0..1 string "The contracted reimbursable amount for covered medical services or supplies or amount reflecting local methodology for non-contracted providers. Allowed amount should not include any COB adjustment. That is, the Allowed amount on a claim should be the same when the Plan is primary or secondary." "The contracted reimbursable amount for covered medical services or supplies or amount reflecting local methodology for non-contracted providers. Allowed amount should not include any COB adjustment. That is, the Allowed amount on a claim should be the same when the Plan is primary or secondary."
* medicalClaim.claimTotalAllowedAmount ^label = "total allowed amount"
* medicalClaim.amountPaidByPatient 0..1 string "The amount paid by the member at the point of service." "The amount paid by the member at the point of service."
* medicalClaim.amountPaidByPatient ^label = "Amount Paid by Patient"
* medicalClaim.claimAmountPaidToProvider 0..1 string "The amount paid to the provider." "The amount paid to the provider."
* medicalClaim.claimAmountPaidToProvider ^label = "Claim Amount Paid to Provider"
* medicalClaim.memberReimbursement 0..1 string "The amount paid to the member." "The amount paid to the member."
* medicalClaim.memberReimbursement ^label = "Member Reimbursement"
* medicalClaim.claimPaymentAmount 0..1 string "The amount sent to the payee from the health plan. This amount is to exclude any member cost sharing.  It should include the total of member and provider payments." "Benefits payable less any payment adjustment."
* medicalClaim.claimPaymentAmount ^label = "Claim Payment Amount"
* medicalClaim.claimNonCoveredAmount 0..1 string "The portion of the cost of this service that was deemed not eligible by the insurer because the service or member was not covered by the subscriber contract." "The portion of the cost of this service that was deemed not eligible by the insurer because the service or member was not covered by the subscriber contract."
* medicalClaim.claimNonCoveredAmount ^label = "Claim Non-covered Amount"
* medicalClaim.memberPaidDeductible 0..1 string "The portion of this service that the member must pay which is applied to the total period deductible. Deductibles are usually applied over a specific time period, such as per calendar year, per benefit period." "The portion of this service that the member must pay which is applied to the total period deductible. Deductibles are usually applied over a specific time period, such as per calendar year, per benefit period."
* medicalClaim.memberPaidDeductible ^label = "Member Paid Deductible"
* medicalClaim.coInsuranceLiabilityAmount 0..1 string "The amount the insured individual pays, as a set percentage of the cost of covered medical services, as an out-of-pocket payment to the provider. Example: Insured pays 20% and the insurer pays 80%." "The amount the insured individual pays, as a set percentage of the cost of covered medical services, as an out-of-pocket payment to the provider. Example: Insured pays 20% and the insurer pays 80%."
* medicalClaim.coInsuranceLiabilityAmount ^label = "Co-insurance Liability Amount"
* medicalClaim.copayAmount 0..1 string "Amount an insured individual pays directly to a provider at the time the services or supplies are rendered. Usually, a copay will be a fixed amount per service, such as $15.00 per office visit." "Amount an insured individual pays directly to a provider at the time the services or supplies are rendered. Usually, a copay will be a fixed amount per service, such as $15.00 per office visit."
* medicalClaim.copayAmount ^label = "Copay Amount"
* medicalClaim.memberLiability 0..1 string "The amount of the member's liability." "The amount of the member's liability."
* medicalClaim.memberLiability ^label = "Member Liability"
* medicalClaim.claimOtherPayerPaidAmount 0..1 string "The reduction in the payment amount to reflect the current carrier as a secondary, teritary, etc, payer.  May be multiple occurrences if the current carrier is a teritary, etc. carrier." "The reduction in the payment amount to reflect the current carrier as a secondary, teritary, etc, payer.  May be multiple occurrences if the current carrier is a teritary, etc. carrier."
* medicalClaim.claimOtherPayerPaidAmount ^label = "Claim Other Payer Paid Amount"
* medicalClaim.claimUse 0..1 PIQICodeableConcept "A code to indicate whether the nature of the request is: to request adjudication of products and services previously rendered; or requesting authorization and adjudication for provision in the future; or requesting the non-binding adjudication of the listed products and services which could be provided in the future." "A code to indicate whether the nature of the request is: to request adjudication of products and services previously rendered; or requesting authorization and adjudication for provision in the future; or requesting the non-binding adjudication of the listed products and services which could be provided in the future."
* medicalClaim.claimUse ^label = "Claim Use"
* medicalClaim.claimLastUpdateDate 0..1 string "Claim Last Update Date" "Claim Last Update Date"
* medicalClaim.claimLastUpdateDate ^label = "last update date"

* claimServiceLine 1..* BackboneElement "Claim Line" "A claim line. Either a simple (a product or service) or a 'group' of details which can also be a simple items or groups of sub-details."
* claimServiceLine ^label = "Claim Line"
